// Liquidity — BSL / SSL (M_LIQ)
liqOn    = input.bool(true, "⑩ Buyside/Sellside Liquidity — enable", group = "⑩ Liquidity (BSL/SSL)")
liqBSL   = input.bool(true, "Buyside (old highs)", group = "⑩ Liquidity (BSL/SSL)", inline = "lqt")
liqSSL   = input.bool(true, "Sellside (old lows)", group = "⑩ Liquidity (BSL/SSL)", inline = "lqt")
