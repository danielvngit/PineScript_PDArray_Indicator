     tooltip = "Auto swing = most recent confirmed swing high <-> swing low. Previous period = prior day/week/month H-L. Session = last completed selected session H-L.")
drPeriod = input.string("Day", "Previous period", options = ["Day", "Week", "Month"], group = "⑫ Dealing Range")
drSession= input.string("London", "Session", options = ["Asia", "London", "New York"], group = "⑫ Dealing Range")
drShowBox= input.bool(true, "Show range box (premium/discount tint)", group = "⑫ Dealing Range")
drShowOte= input.bool(true, "Show OTE band", group = "⑫ Dealing Range")
