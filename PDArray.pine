// Displacement (M_DISP)
dispOn   = input.bool(false, "⑯ Displacement — draw legs", group = "⑯ Displacement",
     tooltip = "Detection always runs (used as a quality gate by ①②⑤⑱). This toggle only controls whether the legs are drawn.")
dispAtr  = input.float(1.5, "Displacement (x ATR)", minval = 0.5, step = 0.1, group = "⑯ Displacement")
