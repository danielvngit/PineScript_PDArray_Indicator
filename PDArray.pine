// SMT Divergence (M_SMT)
smtOn    = input.bool(false, "⑮ SMT Divergence — enable", group = "⑮ SMT Divergence")
smtSym1  = input.symbol("FX:AUDUSD", "Correlated symbol 1", group = "⑮ SMT Divergence")
smtSym2  = input.symbol("", "Correlated symbol 2 (optional)", group = "⑮ SMT Divergence")
smtLine  = input.bool(true, "Draw connector line", group = "⑮ SMT Divergence")
