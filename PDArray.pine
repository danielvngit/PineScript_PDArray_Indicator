drOteHi  = input.float(0.79, "OTE to", minval = 0.5, maxval = 0.95, step = 0.005, group = "⑫ Dealing Range", inline = "ote")
drFibs   = input.string("0.705, 1.0, -0.5", "Extra fib levels (comma list)", group = "⑫ Dealing Range",
     tooltip = "Comma-separated retracement/extension ratios of the leg. 0 = far end, 1 = origin, negatives = extensions. E.g. 0.705 is the ICT sweet spot.")
