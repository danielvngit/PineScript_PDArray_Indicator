lvMax    = input.int(4, "Max shown", minval = 1, maxval = 20, group = "⑦ Liquidity Void")
lvMH     = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "⑦ Liquidity Void")
lvMinBars= input.int(3, "Min bars", minval = 2, maxval = 10, group = "⑦ Liquidity Void")
lvMinAtr = input.float(2.5, "Min range (x ATR)", minval = 0.5, step = 0.5, group = "⑦ Liquidity Void")
lvFillPct= input.float(50.0, "Fill % for mitigation", minval = 10, maxval = 100, step = 5, group = "⑦ Liquidity Void")
lvAge    = input.int(500, "Max age (bars)", minval = 20, group = "⑦ Liquidity Void")

// Volume Imbalance (M_VI)
viOn   = input.bool(true, "⑧ Volume Imbalance — enable", group = "⑧ Volume Imbalance")
