liqBuyCol= input.color(color.new(#26a69a, 0), "BSL color", group = "⑩ Liquidity (BSL/SSL)", inline = "lqc")
liqSellCol=input.color(color.new(#ef5350, 0), "SSL color", group = "⑩ Liquidity (BSL/SSL)", inline = "lqc")
