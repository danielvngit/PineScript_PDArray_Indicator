//@version=6
// ICT PD Array Suite — all ICT Premium/Discount arrays as 18 individually
// toggleable modules on a shared lifecycle / decluttering / rendering core.
// See PRD.md for the full specification. Pine is the source implementation;
// MQL5 and cTrader ports follow in separate epics (E8/E9).
indicator("ICT PD Array Suite", "PD Arrays", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 3000)

// ═════════════════════════════ MODULE IDS ═════════════════════════════
// Kept as plain ints so the shared core can index config with switch().
int M_OB   = 1   // Order Block
int M_BRK  = 2   // Breaker Block
int M_MB   = 3   // Mitigation Block
int M_RB   = 4   // Rejection Block
int M_FVG  = 5   // Fair Value Gap (+ CE)
int M_IFVG = 6   // Inversion FVG
int M_LV   = 7   // Liquidity Void
int M_VI   = 8   // Volume Imbalance
int M_OG   = 9   // Opening Gaps (NDOG / NWOG)
int M_LIQ  = 10  // Buyside / Sellside Liquidity
int M_EQ   = 11  // Equal Highs / Lows
int M_DR   = 12  // Dealing Range (premium/discount/EQ/OTE/fib)
int M_REF  = 13  // Reference Levels (PDH/PDL/PWH/PWL/PMH/PML)
int M_BPR  = 14  // Balanced Price Range
int M_SMT  = 15  // SMT Divergence
int M_DISP = 16  // Displacement
int M_KL   = 17  // Key Levels & Opens
int M_MS   = 18  // Market Structure (BOS / MSS / CHoCH)

// Mitigation rule codes (per-array, set at registration)
int MIT_FAREDGE = 0   // zonal: confirmed close beyond the far edge          → mitigated
int MIT_CE      = 1   // zonal: price wicks through the 50% / CE line        → mitigated
int MIT_SWEEP   = 2   // level: price trades through the level               → swept
int MIT_FRAC    = 3   // zonal: price retraces `mitFrac` from near→far edge  → mitigated

// Mitigated-handling codes
int MH_FADE   = 0
int MH_REMOVE = 1
int MH_KEEP   = 2

// ═════════════════════════════ GLOBAL INPUTS ═════════════════════════════
gEnableAll  = input.bool(true, "Enable All Modules (master switch)", group = "Global / Theme",
     tooltip = "Off = every module is disabled regardless of its own toggle (emergency brake).")
gTheme      = input.string("Neutral", "Color Theme", options = ["Neutral", "Vivid", "Mono"], group = "Global / Theme",
     tooltip = "Preset that tints modules that are left on their default colors. Explicit per-module color overrides always win.")
gCompact    = input.bool(false, "Compact Mode", group = "Global / Theme",
     tooltip = "Thinner borders, no CE / midlines, labels only for above-average-strength arrays. Calms the chart when many modules are on.")
gTranspBase = input.int(80, "Base Transparency", minval = 0, maxval = 95, group = "Global / Theme",
     tooltip = "Transparency of a fresh array. Stronger / fresher arrays render a little more opaque than this.")
gLookback   = input.int(1500, "Lookback Bars", minval = 200, maxval = 5000, group = "Global / Theme",
     tooltip = "Detection and drawing only run within this many bars of the current bar (performance).")
gMergePct   = input.float(80.0, "Merge Overlap %", minval = 0, maxval = 100, step = 5, group = "Global / Theme",
     tooltip = "A new array of the same module + direction that overlaps an existing one by more than this % merges into it instead of duplicating.")
gAtrLen     = input.int(14, "ATR Length", minval = 2, group = "Global / Theme")
gPivL       = input.int(5, "Pivot Left Bars", minval = 1, group = "Global / Theme")
gPivR       = input.int(5, "Pivot Right Bars", minval = 1, group = "Global / Theme",
     tooltip = "Confirmation delay: pivot-based modules only confirm an array this many bars after the swing (non-repaint by design).")

// Info panel
ipShow = input.bool(true, "Show Info Panel", group = "Info Panel")
ipPos  = input.string("Top Right", "Panel Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Info Panel")

// Alerts
alJson     = input.bool(false, "Enable JSON Webhook Alerts", group = "Alerts",
     tooltip = "Additionally emit an alert() call with a JSON payload (see PRD §4.20). Static alertcondition() alerts are always available.")
alResetAtr = input.float(1.0, "Alert Reset (x ATR)", minval = 0.1, step = 0.1, group = "Alerts",
     tooltip = "A per-array 'tapped' alert only re-arms once price is this many ATR away from the array again.")

// ─── Per-module inputs ────────────────────────────────────────────────
// Order Block (M_OB)
obOn      = input.bool(true,  "① Order Block — enable", group = "① Order Block")
obBull    = input.color(color.new(#26a69a, 0), "Bull color", group = "① Order Block", inline = "obc")
obBear    = input.color(color.new(#ef5350, 0), "Bear color", group = "① Order Block", inline = "obc")
obMax     = input.int(6, "Max shown", minval = 1, maxval = 30, group = "① Order Block")
obMH      = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "① Order Block")
obBodyOnly= input.bool(false, "Use body only (ignore wick)", group = "① Order Block")
obReqDisp = input.bool(true, "Require displacement", group = "① Order Block",
     tooltip = "Only register an OB when module ⑯ Displacement flags a move out of it.")
obAge     = input.int(500, "Max age (bars)", minval = 20, group = "① Order Block")

// Breaker (M_BRK)
brkOn   = input.bool(true, "② Breaker Block — enable", group = "② Breaker Block")
brkBull = input.color(color.new(#00897b, 0), "Bull color", group = "② Breaker Block", inline = "brc")
brkBear = input.color(color.new(#e53935, 0), "Bear color", group = "② Breaker Block", inline = "brc")
brkMax  = input.int(4, "Max shown", minval = 1, maxval = 20, group = "② Breaker Block")
brkMH   = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "② Breaker Block")
brkAge  = input.int(500, "Max age (bars)", minval = 20, group = "② Breaker Block")

// Mitigation Block (M_MB)
mbOn   = input.bool(true, "③ Mitigation Block — enable", group = "③ Mitigation Block")
mbBull = input.color(color.new(#66bb6a, 0), "Bull color", group = "③ Mitigation Block", inline = "mbc")
mbBear = input.color(color.new(#ffa726, 0), "Bear color", group = "③ Mitigation Block", inline = "mbc")
mbMax  = input.int(4, "Max shown", minval = 1, maxval = 20, group = "③ Mitigation Block")
mbMH   = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "③ Mitigation Block")
mbAge  = input.int(400, "Max age (bars)", minval = 20, group = "③ Mitigation Block")

// Rejection Block (M_RB)
rbOn    = input.bool(true, "④ Rejection Block — enable", group = "④ Rejection Block")
rbBull  = input.color(color.new(#4db6ac, 0), "Bull color", group = "④ Rejection Block", inline = "rbc")
rbBear  = input.color(color.new(#ff7043, 0), "Bear color", group = "④ Rejection Block", inline = "rbc")
rbMax   = input.int(5, "Max shown", minval = 1, maxval = 20, group = "④ Rejection Block")
rbMH    = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "④ Rejection Block")
rbWickRatio = input.float(0.55, "Min wick / range ratio", minval = 0.3, maxval = 0.95, step = 0.05, group = "④ Rejection Block")
rbMinWickAtr= input.float(0.6, "Min wick (x ATR)", minval = 0.1, step = 0.1, group = "④ Rejection Block")
rbAge   = input.int(400, "Max age (bars)", minval = 20, group = "④ Rejection Block")

// Fair Value Gap (M_FVG)
fvgOn    = input.bool(true, "⑤ Fair Value Gap — enable", group = "⑤ Fair Value Gap")
fvgBull  = input.color(color.new(#42a5f5, 0), "Bull color (BISI)", group = "⑤ Fair Value Gap", inline = "fvc")
fvgBear  = input.color(color.new(#ab47bc, 0), "Bear color (SIBI)", group = "⑤ Fair Value Gap", inline = "fvc")
fvgMax   = input.int(8, "Max shown", minval = 1, maxval = 40, group = "⑤ Fair Value Gap")
fvgMH    = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "⑤ Fair Value Gap",
     tooltip = "Fade/Keep leaves a filled FVG on the chart long enough for module ⑥ to invert it (IFVG). Remove drops it immediately.")
fvgMinAtr= input.float(0.10, "Min gap size (x ATR)", minval = 0.0, step = 0.05, group = "⑤ Fair Value Gap")
fvgReqDisp = input.bool(true, "Require displacement", group = "⑤ Fair Value Gap")
fvgShowCe= input.bool(true, "Show CE (50%) line", group = "⑤ Fair Value Gap")
fvgFill  = input.string("CE (50%)", "Fill rule", options = ["CE (50%)", "Full fill"], group = "⑤ Fair Value Gap")
fvgAge   = input.int(500, "Max age (bars)", minval = 20, group = "⑤ Fair Value Gap")

// Inversion FVG (M_IFVG)
ifvgOn   = input.bool(true, "⑥ Inversion FVG — enable", group = "⑥ Inversion FVG")
ifvgBull = input.color(color.new(#1e88e5, 0), "Bull color", group = "⑥ Inversion FVG", inline = "ifc")
ifvgBear = input.color(color.new(#8e24aa, 0), "Bear color", group = "⑥ Inversion FVG", inline = "ifc")
