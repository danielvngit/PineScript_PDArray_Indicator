// Key Levels & Opens (M_KL)
klOn     = input.bool(true, "⑰ Key Levels & Opens — enable", group = "⑰ Key Levels & Opens")
klMidnight= input.bool(true, "Midnight / True Day Open (00:00)", group = "⑰ Key Levels & Opens")
klEight  = input.bool(true, "08:30 open", group = "⑰ Key Levels & Opens")
klAsia   = input.bool(false, "Asia session H/L", group = "⑰ Key Levels & Opens", inline = "kls")
klLondon = input.bool(true, "London session H/L", group = "⑰ Key Levels & Opens", inline = "kls")
klNY     = input.bool(true, "New York session H/L", group = "⑰ Key Levels & Opens", inline = "kls")
klTz     = input.string("America/New_York", "Timezone", group = "⑰ Key Levels & Opens")
klAsiaSes = input.session("2000-0000", "Asia window", group = "⑰ Key Levels & Opens")
klLdnSes  = input.session("0200-0500", "London window", group = "⑰ Key Levels & Opens")
klNYSes   = input.session("0930-1600", "New York window", group = "⑰ Key Levels & Opens")
klHistory= input.int(1, "Session history (past sessions)", minval = 0, maxval = 5, group = "⑰ Key Levels & Opens")
klOpenCol= input.color(color.new(#ffffff, 0), "Open lines color", group = "⑰ Key Levels & Opens", inline = "klc")
klSesCol = input.color(color.new(#7e57c2, 0), "Session H/L color", group = "⑰ Key Levels & Opens", inline = "klc")

// Market Structure (M_MS)
msOn     = input.bool(true, "⑱ Market Structure (BOS/MSS) — enable", group = "⑱ Market Structure")
msBasis  = input.string("Close", "Structure basis", options = ["Close", "Wick"], group = "⑱ Market Structure")
msReqDisp= input.bool(true, "MSS requires displacement", group = "⑱ Market Structure")
msBosCol = input.color(color.new(#26a69a, 0), "BOS color", group = "⑱ Market Structure", inline = "msc")
msMssCol = input.color(color.new(#ef5350, 0), "MSS color", group = "⑱ Market Structure", inline = "msc")
msMax    = input.int(6, "Max shown", minval = 1, maxval = 20, group = "⑱ Market Structure")

// ═════════════════════════════ TYPES ═════════════════════════════
type PDArray
    int    mod          = 0
    string tag          = ""
    int    dir          = 0          // +1 bull / -1 bear / 0 neutral
    float  top          = na
    float  bot          = na
    float  ce           = na
    int    bornBar      = 0
    int    bornTime     = 0
    int    regBar       = 0          // bar_index the array was first registered
    string status       = "formed"   // formed | tapped | mitigated
    int    lastBar      = 0
    int    mitBar       = 0
    float  strength     = 1.0
    int    count        = 1          // touches / member points (for label)
    bool   isLevel      = false      // render as line(s) instead of a box
    bool   twoLine      = false      // isLevel + draw both top & bot lines
    bool   extend       = false
    int    mitRule      = 0          // MIT_*
    float  mitFrac      = 1.0        // MIT_FRAC: retrace fraction near→far edge
    int    mitHandling  = 0          // MH_*
    int    maxAge       = 500
    int    bornOff      = 0          // bars back from current bar the array originates
    bool   showCe       = false
    bool   shown        = true       // set by f_declutter(); read by f_render()
    color  col          = na         // explicit color override; else derived
    bool   alertedTap   = false
    int    flag         = 0          // module-specific state (e.g. breaker phase, "inverted")
    float  aux          = na         // module-specific scratch value
    // drawing handles
    box    bx           = na
    line   ln1          = na
    line   ln2          = na
    line   lnCe         = na
    label  lb           = na

// ═════════════════════════════ STATE ═════════════════════════════
var array<PDArray> reg = array.new<PDArray>()
int HARD_CAP = 500

// last-event strings — kept in a 1-element-per-slot array so detector FUNCTIONS
// can write them (Pine functions may mutate arrays by reference but not rebind
// global scalars). 0 = last sweep, 1 = last structure, 2 = last SMT.
var array<string> evt = array.new<string>(3, "none")

// dealing-range snapshot filled by module ⑫, read by the info panel.
// 0 = range top, 1 = range bottom, 2 = leg direction (+1 up / -1 down).
var array<float> drBox = array.new<float>(3, na)

// ═════════════════════════════ CALCULATIONS ═════════════════════════════
atr   = ta.atr(gAtrLen)
inLB  = (last_bar_index - bar_index) <= gLookback   // within lookback window
ph    = ta.pivothigh(gPivL, gPivR)
pl    = ta.pivotlow(gPivL, gPivR)

// Hoisted here so history-dependent calls run every bar (never inside the
// conditionally-invoked module detectors — Pine requirement).
_dayChg  = ta.change(time("D"))
_wkChg   = ta.change(time("W"))
newDayG  = not timeframe.isdwm and _dayChg != 0
newWeekG = not timeframe.isdwm and _wkChg != 0

// Displacement (module ⑯) — detection always runs; it is a shared quality gate
// consumed by modules ①②⑤⑱. The toggle only controls whether legs are drawn.
bullDisp = false
bearDisp = false
if barstate.isconfirmed
    _up = true
    _dn = true
    for k = 0 to dispMaxBars - 1
        _r  = high[k] - low[k]
        _br = _r > 0 ? math.abs(close[k] - open[k]) / _r : 0.0
        if _br < dispBodyRatio
            _up := false
            _dn := false
        if close[k] <= open[k]
            _up := false
        if close[k] >= open[k]
            _dn := false
    _legUp = close - low[dispMaxBars - 1]
    _legDn = high[dispMaxBars - 1] - close
    bullDisp := _up and _legUp >= dispAtr * atr
    bearDisp := _dn and _legDn >= dispAtr * atr

// ═════════════════════════════ SHARED CORE ═════════════════════════════
f_mhCode(string s) => s == "Remove" ? MH_REMOVE : s == "Keep" ? MH_KEEP : MH_FADE

// Is a module allowed to run / draw?
f_modOn(int m) =>
    bool on = switch m
        M_OB   => obOn
        M_BRK  => brkOn
        M_MB   => mbOn
        M_RB   => rbOn
        M_FVG  => fvgOn
        M_IFVG => ifvgOn
        M_LV   => lvOn
        M_VI   => viOn
        M_OG   => ogOn
        M_LIQ  => liqOn
        M_EQ   => eqOn
        M_DR   => drOn
        M_REF  => refOn
        M_BPR  => bprOn
        M_SMT  => smtOn
        M_DISP => dispOn
        M_KL   => klOn
        M_MS   => msOn
        => false
    gEnableAll and on

f_modMax(int m) =>
    switch m
        M_OB   => obMax
        M_BRK  => brkMax
        M_MB   => mbMax
        M_RB   => rbMax
        M_FVG  => fvgMax
        M_IFVG => ifvgMax
        M_LV   => lvMax
        M_VI   => viMax
        M_OG   => math.max(ogMaxN, ogMaxW)
        M_LIQ  => liqMax * 2
        M_EQ   => eqMax
        M_DR   => 60
        M_REF  => 12
        M_BPR  => bprMax
        M_SMT  => smtMax
        M_DISP => dispMax
        M_KL   => 40
        M_MS   => msMax
        => 6

// Color for an array: explicit override first, then per-module bull/bear.
f_color(PDArray a) =>
    bull = a.dir >= 0
    color c = switch a.mod
        M_OB   => bull ? obBull    : obBear
        M_BRK  => bull ? brkBull   : brkBear
        M_MB   => bull ? mbBull    : mbBear
        M_RB   => bull ? rbBull    : rbBear
        M_FVG  => bull ? fvgBull   : fvgBear
        M_IFVG => bull ? ifvgBull  : ifvgBear
        M_LV   => bull ? lvBull    : lvBear
        M_VI   => bull ? viBull    : viBear
        M_OG   => bull ? ogBull    : ogBear
        M_LIQ  => bull ? liqBuyCol : liqSellCol
        M_EQ   => bull ? eqLowCol  : eqHighCol
        M_DR   => drEqCol
        M_REF  => refCol
        M_BPR  => bprCol
        M_SMT  => bull ? smtBullCol : smtBearCol
        M_DISP => dispCol
        M_KL   => klOpenCol
        M_MS   => bull ? msBosCol  : msMssCol
        => color.gray
    na(a.col) ? c : a.col

f_overlap(float aTop, float aBot, float bTop, float bBot) =>
    lo    = math.max(aBot, bBot)
    hi    = math.min(aTop, bTop)
    inter = hi - lo
    span  = math.min(aTop - aBot, bTop - bBot)
    span > 0 and inter > 0 ? inter / span * 100.0 : 0.0

f_delete(PDArray a) =>
    if not na(a.bx)
        box.delete(a.bx)
        a.bx := na
    if not na(a.ln1)
        line.delete(a.ln1)
        a.ln1 := na
    if not na(a.ln2)
        line.delete(a.ln2)
        a.ln2 := na
    if not na(a.lnCe)
        line.delete(a.lnCe)
        a.lnCe := na
    if not na(a.lb)
        label.delete(a.lb)
        a.lb := na

// JSON payload for a dynamic alert() (emitted from global scope — see MAIN).
f_payload(string event, PDArray a) =>
    '{"ticker":"'      + syminfo.tickerid                       +
     '","timeframe":"' + timeframe.period                       +
     '","event_type":"'+ event                                  +
     '","module":'     + str.tostring(a.mod)                     +
     ',"array_type":"' + a.tag                                   +
     '","direction":'  + str.tostring(a.dir)                     +
     ',"top":'         + str.tostring(a.top)                     +
     ',"bot":'         + str.tostring(a.bot)                     +
     ',"ce":'          + str.tostring(a.ce)                      +
     ',"price":'       + str.tostring(close)                     +
     ',"time":'        + str.tostring(time)                      + '}'

// Register a prebuilt array — or merge it into an overlapping same-module/same-dir one.
// Caller fills mod/tag/dir/top/bot plus any of: isLevel, twoLine, extend, mitRule,
// mitFrac, mitHandling, maxAge, bornOff, showCe, col. The rest is finalized here.
f_register(PDArray a) =>
    float t = math.max(a.top, a.bot)
    float b = math.min(a.top, a.bot)
    a.top      := t
    a.bot      := b
    a.ce       := (t + b) / 2.0
    a.bornBar  := bar_index - math.max(0, math.min(a.bornOff, gLookback))
    a.bornTime := time
    a.regBar   := bar_index
    a.status   := "formed"
    a.lastBar  := bar_index
    a.strength := 1.0
    a.count    := math.max(1, a.count)
    bool merged = false
    if not a.isLevel and reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == a.mod and e.dir == a.dir and e.status != "mitigated" and f_overlap(t, b, e.top, e.bot) >= gMergePct
                e.top     := math.max(e.top, t)
                e.bot     := math.min(e.bot, b)
                e.ce      := (e.top + e.bot) / 2.0
                e.lastBar := bar_index
                e.count   += 1
                e.strength += 0.5
                merged := true
                break
    if not merged
        reg.push(a)
        if reg.size() > HARD_CAP
            wi = 0
            ws = 1e18
            for i = 0 to reg.size() - 1
                e  = reg.get(i)
                sc = e.strength * 1000.0 - (bar_index - e.bornBar)
                if sc < ws
                    ws := sc
                    wi := i
            f_delete(reg.get(wi))
            reg.remove(wi)

// Lifecycle: status transitions + ageing + cleanup. Runs once per confirmed bar.
f_lifecycle() =>
    if reg.size() > 0
        for i = reg.size() - 1 to 0
            a = reg.get(i)
            bool drop = false
            bool touched = high >= a.bot and low <= a.top
            if a.status == "formed" and touched
                a.status := "tapped"
            if touched
                a.lastBar := bar_index
            if a.status != "mitigated"
                bool mit = false
                if a.mitRule == MIT_SWEEP
                    mit := a.dir >= 0 ? high > a.top : low < a.bot
                    if mit
                        evt.set(0, a.tag + " @ " + str.tostring(a.dir >= 0 ? a.top : a.bot, format.mintick) + " (bar " + str.tostring(bar_index) + ")")
                else if a.mitRule == MIT_CE
                    mit := low <= a.ce and high >= a.ce
                else if a.mitRule == MIT_FRAC
                    lvl = a.dir >= 0 ? a.top - a.mitFrac * (a.top - a.bot) : a.bot + a.mitFrac * (a.top - a.bot)
                    mit := a.dir >= 0 ? low <= lvl : high >= lvl
                else
                    mit := a.dir >= 0 ? close < a.bot : close > a.top
                if mit
                    a.status := "mitigated"
                    a.mitBar := bar_index
            if a.status == "mitigated"
                if a.mitHandling == MH_REMOVE
                    drop := true
                else if a.mitHandling == MH_FADE and (bar_index - a.mitBar) > gPivR + 20
                    drop := true
            if not drop and a.status != "mitigated" and (bar_index - a.lastBar) > a.maxAge
                drop := true
            dist = math.min(math.abs(close - a.top), math.abs(close - a.bot))
            if a.alertedTap and dist > alResetAtr * atr
                a.alertedTap := false
            if drop
                f_delete(a)
                reg.remove(i)

// Decluttering: per module keep only the strongest/most-recent `Max Shown`.
f_declutter() =>
    if reg.size() > 0
        for m = 1 to 18
            keep = f_modMax(m)
            cnt  = 0
            for i = 0 to reg.size() - 1
                if reg.get(i).mod == m
                    cnt += 1
                    reg.get(i).shown := true
            if cnt > keep
                for i = 0 to reg.size() - 1
                    if reg.get(i).mod == m
                        reg.get(i).shown := false
                for pass = 0 to keep - 1
                    bi = -1
                    bv = -1e30
                    for i = 0 to reg.size() - 1
                        e = reg.get(i)
                        if e.mod == m and not e.shown
                            sc = e.strength * 1e6 - (bar_index - e.lastBar) * 1.0
                            if sc > bv
                                bv := sc
                                bi := i
                    if bi >= 0
                        reg.get(bi).shown := true

// Rendering: (re)draw each array's handles honoring compact mode + status.
f_render() =>
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            a = reg.get(i)
            bool draw = a.shown and f_modOn(a.mod) and inLB and (bar_index - a.bornBar) <= gLookback
            if not draw
                f_delete(a)
                continue
            c      = f_color(a)
            agef   = math.min(1.0, (bar_index - a.lastBar) / 300.0)
            tr     = int(math.min(95.0, gTranspBase + agef * 12.0 + (a.status == "mitigated" ? 10.0 : 0.0)))
            trB    = math.max(0, tr - 40)
            trCe   = math.max(0, tr - 30)
            rightX = a.extend ? bar_index + 10 : bar_index + 2
            dstyle = a.status == "mitigated" ? line.style_dotted : line.style_solid
            if a.isLevel
                if na(a.ln1)
                    a.ln1 := line.new(a.bornBar, a.top, rightX, a.top, xloc = xloc.bar_index,
                         color = color.new(c, trB), style = dstyle, width = 1)
                else
                    line.set_xy1(a.ln1, a.bornBar, a.top)
                    line.set_xy2(a.ln1, rightX, a.top)
                    line.set_color(a.ln1, color.new(c, trB))
                    line.set_style(a.ln1, dstyle)
                if a.twoLine
                    if na(a.ln2)
                        a.ln2 := line.new(a.bornBar, a.bot, rightX, a.bot, xloc = xloc.bar_index,
                             color = color.new(c, trB), style = dstyle, width = 1)
                    else
                        line.set_xy1(a.ln2, a.bornBar, a.bot)
                        line.set_xy2(a.ln2, rightX, a.bot)
                        line.set_color(a.ln2, color.new(c, trB))
                        line.set_style(a.ln2, dstyle)
            else
                if na(a.bx)
                    a.bx := box.new(a.bornBar, a.top, rightX, a.bot, xloc = xloc.bar_index,
                         border_color = color.new(c, trB), border_width = 1, border_style = dstyle,
                         bgcolor = color.new(c, tr))
                else
                    box.set_lefttop(a.bx, a.bornBar, a.top)
                    box.set_rightbottom(a.bx, rightX, a.bot)
                    box.set_bgcolor(a.bx, color.new(c, tr))
                    box.set_border_color(a.bx, color.new(c, trB))
                    box.set_border_style(a.bx, dstyle)
                if a.showCe and not gCompact
                    if na(a.lnCe)
                        a.lnCe := line.new(a.bornBar, a.ce, rightX, a.ce, xloc = xloc.bar_index,
                             color = color.new(c, trCe), style = line.style_dashed, width = 1)
                    else
                        line.set_xy1(a.lnCe, a.bornBar, a.ce)
                        line.set_xy2(a.lnCe, rightX, a.ce)
                else if not na(a.lnCe)
                    line.delete(a.lnCe)
                    a.lnCe := na
            bool wantLabel = not (gCompact and a.strength < 1.2)
            if wantLabel
                ly     = a.isLevel ? a.top : (a.dir >= 0 ? a.bot : a.top)
                lstyle = a.dir >= 0 ? label.style_label_upper_left : label.style_label_lower_left
                txt    = a.tag + ((a.mod == M_EQ or a.mod == M_LIQ) and a.count > 1 ? " x" + str.tostring(a.count) : "")
                if na(a.lb)
                    a.lb := label.new(rightX, ly, txt, xloc = xloc.bar_index, style = lstyle,
                         color = color.new(c, 20), textcolor = color.new(color.white, 0), size = size.tiny)
                else
                    label.set_xy(a.lb, rightX, ly)
                    label.set_text(a.lb, txt)
                    label.set_color(a.lb, color.new(c, 20))
            else if not na(a.lb)
                label.delete(a.lb)
                a.lb := na

// ═════════════════════════════ MODULE DETECTORS ═════════════════════════════
// Each runs once per confirmed bar (from MAIN) when its module is enabled.

// ─── ⑤ Fair Value Gap + CE  (E2 · S2.1) ───────────────────────────────
// BISI: low[0] > high[2].  SIBI: high[0] < low[2].  Zone = the 3-candle gap.
f_detect_fvg() =>
    float frac = fvgFill == "CE (50%)" ? 0.5 : 1.0
    int   mh   = f_mhCode(fvgMH)
    // bullish (BISI)
    if low > high[2]
        gap = low - high[2]
        if gap >= fvgMinAtr * atr and (not fvgReqDisp or bullDisp)
            f_register(PDArray.new(mod = M_FVG, tag = "FVG+", dir = 1, top = low, bot = high[2],
                 bornOff = 2, mitRule = MIT_FRAC, mitFrac = frac, mitHandling = mh, maxAge = fvgAge,
                 showCe = fvgShowCe))
    // bearish (SIBI)
    if high < low[2]
        gap = low[2] - high
        if gap >= fvgMinAtr * atr and (not fvgReqDisp or bearDisp)
            f_register(PDArray.new(mod = M_FVG, tag = "FVG-", dir = -1, top = low[2], bot = high,
                 bornOff = 2, mitRule = MIT_FRAC, mitFrac = frac, mitHandling = mh, maxAge = fvgAge,
                 showCe = fvgShowCe))

// ─── ⑥ Inversion FVG  (E2 · S2.2) ─────────────────────────────────────
// An existing FVG that price closes fully through flips polarity → IFVG.
f_detect_ifvg() =>
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == M_FVG and e.flag == 0
                bool through = e.dir >= 0 ? close < e.bot : close > e.top
                if through
                    e.flag   := 1
                    e.status := "mitigated"
                    e.mitBar := bar_index
                    ndir = e.dir >= 0 ? -1 : 1
                    f_register(PDArray.new(mod = M_IFVG, tag = ndir > 0 ? "IFVG+" : "IFVG-", dir = ndir,
                         top = e.top, bot = e.bot, bornOff = bar_index - e.bornBar, mitRule = MIT_FRAC,
                         mitFrac = 1.0, mitHandling = f_mhCode(ifvgMH), maxAge = ifvgAge))

// ─── ⑦ Liquidity Void  (E2 · S2.3) ───────────────────────────────────
// Fast one-directional run: N same-colour bars, big directional range, strong bodies.
f_detect_lv() =>
    int n = lvMinBars
    bool up = true
    bool dn = true
    for k = 0 to n - 1
        r  = high[k] - low[k]
        br = r > 0 ? math.abs(close[k] - open[k]) / r : 0.0
        if br < 0.5
            up := false
            dn := false
        if close[k] <= open[k]
            up := false
        if close[k] >= open[k]
            dn := false
    if up
        rng = high - low[n - 1]
        if rng >= lvMinAtr * atr and close > close[n - 1]
            f_register(PDArray.new(mod = M_LV, tag = "LV+", dir = 1, top = high, bot = low[n - 1],
                 bornOff = n - 1, mitRule = MIT_FRAC, mitFrac = lvFillPct / 100.0,
                 mitHandling = f_mhCode(lvMH), maxAge = lvAge))
    if dn
        rng = high[n - 1] - low
        if rng >= lvMinAtr * atr and close < close[n - 1]
            f_register(PDArray.new(mod = M_LV, tag = "LV-", dir = -1, top = high[n - 1], bot = low,
                 bornOff = n - 1, mitRule = MIT_FRAC, mitFrac = lvFillPct / 100.0,
                 mitHandling = f_mhCode(lvMH), maxAge = lvAge))

// ─── ⑧ Volume Imbalance  (E2 · S2.4) ─────────────────────────────────
// Body gap between consecutive candles while their wicks still overlap.
f_detect_vi() =>
    int mh = f_mhCode(viMH)
    if open > close[1] and low <= high[1] and (open - close[1]) >= 0.05 * atr
        f_register(PDArray.new(mod = M_VI, tag = "VI+", dir = 1, top = open, bot = close[1],
             bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0, mitHandling = mh, maxAge = viAge))
    if open < close[1] and high >= low[1] and (close[1] - open) >= 0.05 * atr
        f_register(PDArray.new(mod = M_VI, tag = "VI-", dir = -1, top = close[1], bot = open,
             bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0, mitHandling = mh, maxAge = viAge))

// ─── ⑨ Opening Gaps — NDOG / NWOG  (E2 · S2.5) ───────────────────────
f_detect_og() =>
    if not timeframe.isdwm
        int mh = f_mhCode(ogMH)
        bool newDay  = newDayG
        bool newWeek = newWeekG
        if ogNwog and newWeek and not na(close[1]) and math.abs(open - close[1]) >= 0.05 * atr
            d = open > close[1] ? 1 : -1
            f_register(PDArray.new(mod = M_OG, tag = "NWOG", dir = d, top = math.max(open, close[1]),
                 bot = math.min(open, close[1]), bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0,
                 mitHandling = mh, maxAge = ogAge, showCe = true))
        else if ogNdog and newDay and not na(close[1]) and math.abs(open - close[1]) >= 0.05 * atr
            d = open > close[1] ? 1 : -1
            f_register(PDArray.new(mod = M_OG, tag = "NDOG", dir = d, top = math.max(open, close[1]),
                 bot = math.min(open, close[1]), bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0,
                 mitHandling = mh, maxAge = ogAge, showCe = true))

// ─── ⑭ Balanced Price Range  (E2 · S2.6) ─────────────────────────────
// Overlap of a bullish and a bearish FVG formed within N bars of each other.
f_detect_bpr() =>
    if reg.size() > 1
        for i = 0 to reg.size() - 1
            eb = reg.get(i)
            if eb.mod == M_FVG and eb.dir >= 0
                for j = 0 to reg.size() - 1
                    es = reg.get(j)
                    if es.mod == M_FVG and es.dir < 0
                        newPair = eb.regBar == bar_index or es.regBar == bar_index
                        near    = math.abs(eb.bornBar - es.bornBar) <= bprMaxApart
                        ot      = math.min(eb.top, es.top)
                        ob      = math.max(eb.bot, es.bot)
                        if newPair and near and ot > ob
                            f_register(PDArray.new(mod = M_BPR, tag = "BPR", dir = 0, top = ot, bot = ob,
                                 bornOff = bar_index - math.min(eb.bornBar, es.bornBar), mitRule = MIT_FRAC,
                                 mitFrac = 1.0, mitHandling = f_mhCode(bprMH), maxAge = bprAge))

// ─── helper: does an un-mitigated array of module m + dir d overlap [t,b]? ───
f_hasOverlap(int m, int d, float t, float b) =>
    bool found = false
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == m and e.dir == d and e.status != "mitigated" and f_overlap(t, b, e.top, e.bot) > 0
                found := true
                break
    found

// ─── ① Order Block (+ propulsion)  (E3 · S3.1) ───────────────────────
// Last opposite-close candle before a displacement leg. Structure-break
// requirement is approximated by the displacement gate (module ⑯); the
// OB<->breaker distinction is refined by module ⑱ (see PRD §8).
f_detect_ob() =>
    int   mh   = f_mhCode(obMH)
    int   look = 6
    // bullish OB — rising edge of an up displacement
    if (not obReqDisp or bullDisp) and (obReqDisp ? not bullDisp[1] : close > open and close[1] < open[1])
        int kk = -1
        for k = 1 to look
            if kk < 0 and close[k] < open[k]
                kk := k
        if kk >= 0
            t = obBodyOnly ? math.max(open[kk], close[kk]) : high[kk]
            b = obBodyOnly ? math.min(open[kk], close[kk]) : low[kk]
            prop = f_hasOverlap(M_OB, 1, t, b)
            f_register(PDArray.new(mod = M_OB, tag = prop ? "OB+^" : "OB+", dir = 1, top = t, bot = b,
                 bornOff = kk, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = obAge, showCe = true))
    // bearish OB
    if (not obReqDisp or bearDisp) and (obReqDisp ? not bearDisp[1] : close < open and close[1] > open[1])
        int kk = -1
        for k = 1 to look
            if kk < 0 and close[k] > open[k]
                kk := k
        if kk >= 0
            t = obBodyOnly ? math.max(open[kk], close[kk]) : high[kk]
            b = obBodyOnly ? math.min(open[kk], close[kk]) : low[kk]
            prop = f_hasOverlap(M_OB, -1, t, b)
            f_register(PDArray.new(mod = M_OB, tag = prop ? "OB-^" : "OB-", dir = -1, top = t, bot = b,
                 bornOff = kk, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = obAge, showCe = true))

// ─── ② Breaker Block  (E3 · S3.2) ────────────────────────────────────
// An OB that is violated (close beyond it) and then retested from the far
// side flips role: broken bull OB -> bearish breaker, and vice versa.
f_detect_brk() =>
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == M_OB and e.flag < 2
                if e.flag == 0
                    violated = e.dir >= 0 ? close < e.bot : close > e.top
                    if violated
                        e.flag := 1
                else if e.flag == 1
                    retest = high >= e.bot and low <= e.top
                    if retest
                        e.flag := 2
                        ndir = e.dir >= 0 ? -1 : 1
                        f_register(PDArray.new(mod = M_BRK, tag = ndir > 0 ? "BRK+" : "BRK-", dir = ndir,
                             top = e.top, bot = e.bot, bornOff = bar_index - e.bornBar,
                             mitRule = MIT_FAREDGE, mitHandling = f_mhCode(brkMH), maxAge = brkAge, showCe = true))

// ─── ③ Mitigation Block  (E3 · S3.3) ─────────────────────────────────
// The "weak" OB counterpart: an opposite-close candle preceding a NON-
// displacement reversal (no structure break). Distinct from a breaker,
// which requires the prior block to be violated first (PRD §8).
f_detect_mb() =>
    int mh = f_mhCode(mbMH)
    if close > open and close[1] < open[1] and not bullDisp and (close - open) >= 0.4 * (high - low)
        t = high[1]
        b = low[1]
        if not f_hasOverlap(M_OB, 1, t, b) and not f_hasOverlap(M_MB, 1, t, b)
            f_register(PDArray.new(mod = M_MB, tag = "MB+", dir = 1, top = t, bot = b, bornOff = 1,
                 mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = mbAge, showCe = true))
    if close < open and close[1] > open[1] and not bearDisp and (open - close) >= 0.4 * (high - low)
        t = high[1]
        b = low[1]
        if not f_hasOverlap(M_OB, -1, t, b) and not f_hasOverlap(M_MB, -1, t, b)
            f_register(PDArray.new(mod = M_MB, tag = "MB-", dir = -1, top = t, bot = b, bornOff = 1,
                 mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = mbAge, showCe = true))

// ─── ④ Rejection Block  (E3 · S3.4) ──────────────────────────────────
// Long-wick candle at a local extreme; zone = the wick.
f_detect_rb() =>
    int   mh  = f_mhCode(rbMH)
    rng  = high - low
    uw   = high - math.max(open, close)
    lw   = math.min(open, close) - low
    if rng > 0 and uw >= rbWickRatio * rng and uw >= rbMinWickAtr * atr and high >= high[1] and high >= high[2]
        f_register(PDArray.new(mod = M_RB, tag = "RB-", dir = -1, top = high, bot = math.max(open, close),
             bornOff = 0, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = rbAge))
    if rng > 0 and lw >= rbWickRatio * rng and lw >= rbMinWickAtr * atr and low <= low[1] and low <= low[2]
        f_register(PDArray.new(mod = M_RB, tag = "RB+", dir = 1, top = math.min(open, close), bot = low,
             bornOff = 0, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = rbAge))
f_detect_liq()  => false        // E4 · S4.1 / S4.2
f_detect_eq()   => false        // E4 · S4.3
f_detect_disp() => false        // E4 · S4.4 (leg drawing; booleans computed above)
f_detect_ms()   => false        // E4 · S4.5
f_detect_dr()   => false        // E5 · S5.1 / S5.2
f_detect_ref()  => false        // E5 · S5.3
f_detect_kl()   => false        // E5 · S5.4
f_detect_smt()  => false        // E6 · S6.1 / S6.2

// ═════════════════════════════ MAIN ═════════════════════════════
if barstate.isconfirmed and inLB
    if f_modOn(M_FVG)
        f_detect_fvg()
    if f_modOn(M_IFVG)
        f_detect_ifvg()
    if f_modOn(M_LV)
        f_detect_lv()
    if f_modOn(M_VI)
        f_detect_vi()
    if f_modOn(M_OG)
        f_detect_og()
    if f_modOn(M_OB)
        f_detect_ob()
    if f_modOn(M_BRK)
        f_detect_brk()
    if f_modOn(M_MB)
        f_detect_mb()
    if f_modOn(M_RB)
        f_detect_rb()
    if f_modOn(M_LIQ)
        f_detect_liq()
    if f_modOn(M_EQ)
        f_detect_eq()
    if f_modOn(M_MS)
        f_detect_ms()
    if f_modOn(M_DR)
        f_detect_dr()
    if f_modOn(M_REF)
        f_detect_ref()
    if f_modOn(M_KL)
        f_detect_kl()
    if f_modOn(M_SMT)
        f_detect_smt()
    if f_modOn(M_BPR)
        f_detect_bpr()
    if dispOn
        f_detect_disp()
    f_lifecycle()
    f_declutter()

f_render()

// ═════════════════════════════ INFO PANEL ═════════════════════════════
var table ip = na
if ipShow and barstate.islast
    pos = switch ipPos
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right
    if na(ip)
        ip := table.new(pos, 2, 8, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
    else
        table.set_position(ip, pos)
    float  nBull  = na
    string nBullT = "—"
    float  nBear  = na
    string nBearT = "—"
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.status != "mitigated" and e.shown
                if e.top <= close and (na(nBull) or e.top > nBull)
                    nBull  := e.top
                    nBullT := e.tag
                if e.bot >= close and (na(nBear) or e.bot < nBear)
                    nBear  := e.bot
                    nBearT := e.tag
    string drPosTxt = "—"
    drT = drBox.get(0)
    drB = drBox.get(1)
    if not na(drT) and not na(drB) and drT > drB
        pct = (close - drB) / (drT - drB) * 100.0
        drPosTxt := (pct >= 50 ? "Premium " : "Discount ") + str.tostring(pct, "#.#") + "%"
    table.cell(ip, 0, 0, "PD ARRAY SUITE", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 70))
    table.cell(ip, 1, 0, str.tostring(reg.size()) + " tracked", text_color = color.silver, text_size = size.small)
    table.cell(ip, 0, 1, "Dealing range", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 1, drPosTxt, text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 2, "Nearest ▲ below", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 2, nBullT + (na(nBull) ? "" : " " + str.tostring(nBull, format.mintick)), text_color = color.new(#26a69a, 0), text_size = size.small)
    table.cell(ip, 0, 3, "Nearest ▼ above", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 3, nBearT + (na(nBear) ? "" : " " + str.tostring(nBear, format.mintick)), text_color = color.new(#ef5350, 0), text_size = size.small)
    table.cell(ip, 0, 4, "Last sweep", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 4, evt.get(0), text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 5, "Last structure", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 5, evt.get(1), text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 6, "Last SMT", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 6, evt.get(2), text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 7, "Displacement", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 7, bullDisp ? "▲ bull" : bearDisp ? "▼ bear" : "—", text_color = color.white, text_size = size.small)

// ═════════════════════════════ STATIC ALERTS ═════════════════════════════
// Real per-module conditions are wired in E7 · S7.2; these keep the alert names
// registered so users can pre-create alerts.
alertcondition(false, "PD Array — formed",       "A PD array formed")
alertcondition(false, "PD Array — tapped",       "Price tapped a PD array")
alertcondition(false, "PD Array — mitigated",    "A PD array was mitigated")
alertcondition(false, "Liquidity swept",         "Buyside/Sellside liquidity was swept")
alertcondition(false, "Market structure shift",  "BOS / MSS / CHoCH")
alertcondition(false, "SMT divergence",          "SMT divergence detected")
