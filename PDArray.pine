ogMH     = input.string("Fade", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "⑨ Opening Gaps (NDOG/NWOG)")
ogAge    = input.int(600, "Max age (bars)", minval = 20, group = "⑨ Opening Gaps (NDOG/NWOG)")

// Liquidity — BSL / SSL (M_LIQ)
liqOn    = input.bool(true, "⑩ Buyside/Sellside Liquidity — enable", group = "⑩ Liquidity (BSL/SSL)")
