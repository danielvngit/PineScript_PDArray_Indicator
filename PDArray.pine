drEqCol  = input.color(color.new(#b0bec5, 0), "Equilibrium / fib color", group = "⑫ Dealing Range")

// Reference Levels (M_REF)
refOn    = input.bool(true, "⑬ Reference Levels — enable", group = "⑬ Reference Levels")
