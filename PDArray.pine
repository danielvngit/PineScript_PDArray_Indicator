viBear = input.color(color.new(#ec407a, 0), "Bear color", group = "⑧ Volume Imbalance", inline = "vic")
viMax  = input.int(6, "Max shown", minval = 1, maxval = 30, group = "⑧ Volume Imbalance")
viMH   = input.string("Remove", "Mitigated handling", options = ["Fade", "Remove", "Keep"], group = "⑧ Volume Imbalance")
viAge  = input.int(300, "Max age (bars)", minval = 20, group = "⑧ Volume Imbalance")

// Opening Gaps (M_OG)
ogOn     = input.bool(true, "⑨ Opening Gaps — enable", group = "⑨ Opening Gaps (NDOG/NWOG)")
ogNdog   = input.bool(true, "NDOG (new day)", group = "⑨ Opening Gaps (NDOG/NWOG)", inline = "ogt")
ogNwog   = input.bool(true, "NWOG (new week)", group = "⑨ Opening Gaps (NDOG/NWOG)", inline = "ogt")
ogBull   = input.color(color.new(#5c6bc0, 0), "Up color", group = "⑨ Opening Gaps (NDOG/NWOG)", inline = "ogc")
ogBear   = input.color(color.new(#d4e157, 0), "Down color", group = "⑨ Opening Gaps (NDOG/NWOG)", inline = "ogc")
