// Dealing Range (M_DR)
drOn     = input.bool(true, "⑫ Dealing Range — enable", group = "⑫ Dealing Range")
drSrc    = input.string("Auto swing", "Range source", options = ["Auto swing", "Previous period", "Session"], group = "⑫ Dealing Range")
drPeriod = input.string("Day", "Previous period", options = ["Day", "Week", "Month"], group = "⑫ Dealing Range")
drSession= input.string("London", "Session", options = ["Asia", "London", "New York"], group = "⑫ Dealing Range")
