dispCol  = input.color(color.new(#ffee58, 40), "Leg color", group = "⑯ Displacement")
dispMax  = input.int(4, "Max shown", minval = 1, maxval = 20, group = "⑯ Displacement")

// Key Levels & Opens (M_KL)
klOn     = input.bool(true, "⑰ Key Levels & Opens — enable", group = "⑰ Key Levels & Opens")
klMidnight= input.bool(true, "Midnight / True Day Open (00:00)", group = "⑰ Key Levels & Opens")
klEight  = input.bool(true, "08:30 open", group = "⑰ Key Levels & Opens")
klAsia   = input.bool(false, "Asia session H/L", group = "⑰ Key Levels & Opens", inline = "kls")
klLondon = input.bool(true, "London session H/L", group = "⑰ Key Levels & Opens", inline = "kls")
klNY     = input.bool(true, "New York session H/L", group = "⑰ Key Levels & Opens", inline = "kls")
klTz     = input.string("America/New_York", "Timezone", group = "⑰ Key Levels & Opens")
klAsiaSes = input.session("2000-0000", "Asia window", group = "⑰ Key Levels & Opens")
klLdnSes  = input.session("0200-0500", "London window", group = "⑰ Key Levels & Opens")
klNYSes   = input.session("0930-1600", "New York window", group = "⑰ Key Levels & Opens")
klHistory= input.int(1, "Session history (past sessions)", minval = 0, maxval = 5, group = "⑰ Key Levels & Opens")
klOpenCol= input.color(color.new(#ffffff, 0), "Open lines color", group = "⑰ Key Levels & Opens", inline = "klc")
klSesCol = input.color(color.new(#7e57c2, 0), "Session H/L color", group = "⑰ Key Levels & Opens", inline = "klc")

// Market Structure (M_MS)
msOn     = input.bool(true, "⑱ Market Structure (BOS/MSS) — enable", group = "⑱ Market Structure")
msBasis  = input.string("Close", "Structure basis", options = ["Close", "Wick"], group = "⑱ Market Structure")
msReqDisp= input.bool(true, "MSS requires displacement", group = "⑱ Market Structure")
msBosCol = input.color(color.new(#26a69a, 0), "BOS color", group = "⑱ Market Structure", inline = "msc")
msMssCol = input.color(color.new(#ef5350, 0), "MSS color", group = "⑱ Market Structure", inline = "msc")
msMax    = input.int(6, "Max shown", minval = 1, maxval = 20, group = "⑱ Market Structure")

// ═════════════════════════════ TYPES ═════════════════════════════
type PDArray
    int    mod          = 0
    string tag          = ""
    int    dir          = 0          // +1 bull / -1 bear / 0 neutral
    float  top          = na
    float  bot          = na
    float  ce           = na
    int    bornBar      = 0
    int    bornTime     = 0
    int    regBar       = 0          // bar_index the array was first registered
    string status       = "formed"   // formed | tapped | mitigated
    int    lastBar      = 0
    int    mitBar       = 0
    int    tapBar       = 0          // bar of the most recent (debounced) tap
    float  strength     = 1.0
    int    count        = 1          // touches / member points (for label)
    bool   isLevel      = false      // render as line(s) instead of a box
    bool   twoLine      = false      // isLevel + draw both top & bot lines
    bool   extend       = false
    int    mitRule      = 0          // MIT_*
    float  mitFrac      = 1.0        // MIT_FRAC: retrace fraction near→far edge
    int    mitHandling  = 0          // MH_*
    int    maxAge       = 500
    int    bornOff      = 0          // bars back from current bar the array originates
    bool   showCe       = false
    bool   shown        = true       // set by f_declutter(); read by f_render()
    color  col          = na         // explicit color override; else derived
    bool   alertedTap   = false
    int    flag         = 0          // module-specific state (e.g. breaker phase, "inverted")
    float  aux          = na         // module-specific scratch value
    // drawing handles
    box    bx           = na
    line   ln1          = na
    line   ln2          = na
    line   lnCe         = na
    label  lb           = na

// ═════════════════════════════ STATE ═════════════════════════════
var array<PDArray> reg = array.new<PDArray>()
int HARD_CAP = 500

// last-event strings — kept in a 1-element-per-slot array so detector FUNCTIONS
// can write them (Pine functions may mutate arrays by reference but not rebind
// global scalars). 0 = last sweep, 1 = last structure, 2 = last SMT.
var array<string> evt = array.new<string>(3, "none")

// dealing-range snapshot filled by module ⑫, read by the info panel.
// 0 = range top, 1 = range bottom, 2 = leg direction (+1 up / -1 down).
var array<float> drBox = array.new<float>(3, na)

// recent confirmed pivots (shared by modules ⑩ ⑪ ⑮ ⑱); newest appended last.
var array<float> phBuf     = array.new<float>()
var array<int>   phBarBuf  = array.new<int>()
var array<float> plBuf     = array.new<float>()
var array<int>   plBarBuf  = array.new<int>()
// correlated-symbol high/low sampled at each pivot bar (module ⑮ — avoids
// dynamic historical indexing of a request.security series).
var array<float> smtPh1 = array.new<float>()
var array<float> smtPh2 = array.new<float>()
var array<float> smtPl1 = array.new<float>()
var array<float> smtPl2 = array.new<float>()
int PIV_BUF = 12   // keep this many recent pivots per side

// market-structure state for module ⑱ (function-writable via .set()).
// 0 = protected high, 1 = its bar, 2 = protected low, 3 = its bar, 4 = trend(+1/-1/0)
var array<float> msState = array.new<float>(5, na)

// ═════════════════════════════ CALCULATIONS ═════════════════════════════
atr   = ta.atr(gAtrLen)
inLB  = (last_bar_index - bar_index) <= gLookback   // within lookback window
ph    = ta.pivothigh(gPivL, gPivR)
pl    = ta.pivotlow(gPivL, gPivR)
volOk = ta.cum(nz(volume)) > 0                      // is volume data available?

// Hoisted here so history-dependent calls run every bar (never inside the
// conditionally-invoked module detectors — Pine requirement).
_dayChg  = ta.change(time("D"))
_wkChg   = ta.change(time("W"))
_moChg   = ta.change(time("M"))
newDayG   = not timeframe.isdwm and _dayChg != 0
newWeekG  = not timeframe.isdwm and _wkChg  != 0
newMonthG = not timeframe.isdwm and _moChg  != 0

// ── HTF previous-period high/low for module ⑬ (non-repaint via [1]) ──
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_off)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_off)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_off)

// ── session state for modules ⑫ (Session source) and ⑰ ──
_inA = not na(time(timeframe.period, klAsiaSes, klTz))
_inL = not na(time(timeframe.period, klLdnSes,  klTz))
_inN = not na(time(timeframe.period, klNYSes,   klTz))
var float sesAH = na
var float sesAL = na
var float sesLH = na
var float sesLL = na
var float sesNH = na
var float sesNL = na
var float sesAHc = na   // last completed
var float sesALc = na
var float sesLHc = na
var float sesLLc = na
var float sesNHc = na
var float sesNLc = na
if _inA
    startA = not _inA[1]
    sesAH := startA or na(sesAH) ? high : math.max(sesAH, high)
    sesAL := startA or na(sesAL) ? low  : math.min(sesAL, low)
if _inA[1] and not _inA
    sesAHc := sesAH
    sesALc := sesAL
    sesAH  := na
    sesAL  := na
if _inL
    startL = not _inL[1]
    sesLH := startL or na(sesLH) ? high : math.max(sesLH, high)
    sesLL := startL or na(sesLL) ? low  : math.min(sesLL, low)
if _inL[1] and not _inL
    sesLHc := sesLH
    sesLLc := sesLL
    sesLH  := na
    sesLL  := na
if _inN
    startN = not _inN[1]
    sesNH := startN or na(sesNH) ? high : math.max(sesNH, high)
    sesNL := startN or na(sesNL) ? low  : math.min(sesNL, low)
if _inN[1] and not _inN
    sesNHc := sesNH
    sesNLc := sesNL
    sesNH  := na
    sesNL  := na

// ── key opens for module ⑰ (New York local clock) ──
_nyDayChg = ta.change(dayofmonth(time, klTz)) != 0
_ny0830   = (hour(time, klTz) == 8 and minute(time, klTz) >= 30) and not (hour(time[1], klTz) == 8 and minute(time[1], klTz) >= 30)

// ── correlated-symbol series for module ⑮ (SMT) ──
_smtS1 = smtSym1
_smtS2 = smtSym2 == "" ? syminfo.tickerid : smtSym2
smtH1 = request.security(_smtS1, timeframe.period, high, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
smtL1 = request.security(_smtS1, timeframe.period, low,  lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
smtH2 = request.security(_smtS2, timeframe.period, high, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
smtL2 = request.security(_smtS2, timeframe.period, low,  lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

// Displacement (module ⑯) — detection always runs; it is a shared quality gate
// consumed by modules ①②⑤⑱. The toggle only controls whether legs are drawn.
bullDisp = false
bearDisp = false
if barstate.isconfirmed
    _up = true
    _dn = true
    for k = 0 to dispMaxBars - 1
        _r  = high[k] - low[k]
        _br = _r > 0 ? math.abs(close[k] - open[k]) / _r : 0.0
        if _br < dispBodyRatio
            _up := false
            _dn := false
        if close[k] <= open[k]
            _up := false
        if close[k] >= open[k]
            _dn := false
    _legUp = close - low[dispMaxBars - 1]
    _legDn = high[dispMaxBars - 1] - close
    bullDisp := _up and _legUp >= dispAtr * atr
    bearDisp := _dn and _legDn >= dispAtr * atr

// ═════════════════════════════ SHARED CORE ═════════════════════════════
f_mhCode(string s) => s == "Remove" ? MH_REMOVE : s == "Keep" ? MH_KEEP : MH_FADE

// Is a module allowed to run / draw?
f_modOn(int m) =>
    bool on = switch m
        M_OB   => obOn
        M_BRK  => brkOn
        M_MB   => mbOn
        M_RB   => rbOn
        M_FVG  => fvgOn
        M_IFVG => ifvgOn
        M_LV   => lvOn
        M_VI   => viOn
        M_OG   => ogOn
        M_LIQ  => liqOn
        M_EQ   => eqOn
        M_DR   => drOn
        M_REF  => refOn
        M_BPR  => bprOn
        M_SMT  => smtOn
        M_DISP => dispOn
        M_KL   => klOn
        M_MS   => msOn
        => false
    gEnableAll and on

f_modMax(int m) =>
    switch m
        M_OB   => obMax
        M_BRK  => brkMax
        M_MB   => mbMax
        M_RB   => rbMax
        M_FVG  => fvgMax
        M_IFVG => ifvgMax
        M_LV   => lvMax
        M_VI   => viMax
        M_OG   => math.max(ogMaxN, ogMaxW)
        M_LIQ  => liqMax * 2
        M_EQ   => eqMax
        M_DR   => 60
        M_REF  => 12
        M_BPR  => bprMax
        M_SMT  => smtMax
        M_DISP => dispMax
        M_KL   => 40
        M_MS   => msMax
        => 6

// Color for an array: explicit override first, then per-module bull/bear.
f_color(PDArray a) =>
    bull = a.dir >= 0
    color c = switch a.mod
        M_OB   => bull ? obBull    : obBear
        M_BRK  => bull ? brkBull   : brkBear
        M_MB   => bull ? mbBull    : mbBear
        M_RB   => bull ? rbBull    : rbBear
        M_FVG  => bull ? fvgBull   : fvgBear
        M_IFVG => bull ? ifvgBull  : ifvgBear
        M_LV   => bull ? lvBull    : lvBear
        M_VI   => bull ? viBull    : viBear
        M_OG   => bull ? ogBull    : ogBear
        M_LIQ  => bull ? liqBuyCol : liqSellCol
        M_EQ   => bull ? eqLowCol  : eqHighCol
        M_DR   => drEqCol
        M_REF  => refCol
        M_BPR  => bprCol
        M_SMT  => bull ? smtBullCol : smtBearCol
        M_DISP => dispCol
        M_KL   => klOpenCol
        M_MS   => bull ? msBosCol  : msMssCol
        => color.gray
    // explicit per-array override always wins; otherwise the theme preset
    // re-tints the per-module default colors.
    color themed = c
    if na(a.col)
        if gTheme == "Mono"
            themed := a.dir > 0 ? color.new(#5b7d6e, 0) : a.dir < 0 ? color.new(#9a5b5b, 0) : color.new(#8a8a8a, 0)
        else if gTheme == "Vivid"
            themed := a.dir > 0 ? color.new(#00e676, 0) : a.dir < 0 ? color.new(#ff1744, 0) : color.new(#448aff, 0)
    na(a.col) ? themed : a.col

f_overlap(float aTop, float aBot, float bTop, float bBot) =>
    lo    = math.max(aBot, bBot)
    hi    = math.min(aTop, bTop)
    inter = hi - lo
    span  = math.min(aTop - aBot, bTop - bBot)
    span > 0 and inter > 0 ? inter / span * 100.0 : 0.0

f_delete(PDArray a) =>
    if not na(a.bx)
        box.delete(a.bx)
        a.bx := na
    if not na(a.ln1)
        line.delete(a.ln1)
        a.ln1 := na
    if not na(a.ln2)
        line.delete(a.ln2)
        a.ln2 := na
    if not na(a.lnCe)
        line.delete(a.lnCe)
        a.lnCe := na
    if not na(a.lb)
        label.delete(a.lb)
        a.lb := na

// JSON payload for a dynamic alert() (emitted from global scope — see MAIN).
f_payload(string event, PDArray a) =>
    '{"ticker":"'      + syminfo.tickerid                       +
     '","timeframe":"' + timeframe.period                       +
     '","event_type":"'+ event                                  +
     '","module":'     + str.tostring(a.mod)                     +
     ',"array_type":"' + a.tag                                   +
     '","direction":'  + str.tostring(a.dir)                     +
     ',"top":'         + str.tostring(a.top)                     +
     ',"bot":'         + str.tostring(a.bot)                     +
     ',"ce":'          + str.tostring(a.ce)                      +
     ',"price":'       + str.tostring(close)                     +
     ',"time":'        + str.tostring(time)                      + '}'

// Register a prebuilt array — or merge it into an overlapping same-module/same-dir one.
// Caller fills mod/tag/dir/top/bot plus any of: isLevel, twoLine, extend, mitRule,
// mitFrac, mitHandling, maxAge, bornOff, showCe, col. The rest is finalized here.
f_register(PDArray a) =>
    float t = math.max(a.top, a.bot)
    float b = math.min(a.top, a.bot)
    a.top      := t
    a.bot      := b
    a.ce       := (t + b) / 2.0
    a.bornBar  := bar_index - math.max(0, math.min(a.bornOff, gLookback))
    a.bornTime := time
    a.regBar   := bar_index
    a.status   := "formed"
    a.lastBar  := bar_index
    a.strength := 1.0
    a.count    := math.max(1, a.count)
    bool merged = false
    if reg.size() > 0
        tolLvl = atr * 0.15
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            bool hit = false
            if e.mod == a.mod and e.dir == a.dir and e.status != "mitigated"
                if a.isLevel and e.isLevel
                    hit := math.abs(e.top - t) <= tolLvl
                else if not a.isLevel and not e.isLevel
                    hit := f_overlap(t, b, e.top, e.bot) >= gMergePct
            if hit
                e.top     := a.isLevel ? (e.top + t) / 2.0 : math.max(e.top, t)
                e.bot     := a.isLevel ? (e.bot + b) / 2.0 : math.min(e.bot, b)
                e.ce      := (e.top + e.bot) / 2.0
                e.lastBar := bar_index
                e.count   += 1
                e.strength += 0.5
                merged := true
                break
    if not merged
        reg.push(a)
        if reg.size() > HARD_CAP
            wi = 0
            ws = 1e18
            for i = 0 to reg.size() - 1
                e  = reg.get(i)
                sc = e.strength * 1000.0 - (bar_index - e.bornBar)
                if sc < ws
                    ws := sc
                    wi := i
            f_delete(reg.get(wi))
            reg.remove(wi)

// Lifecycle: status transitions + ageing + cleanup. Runs once per confirmed bar.
f_lifecycle() =>
    if reg.size() > 0
        for i = reg.size() - 1 to 0
            a = reg.get(i)
            bool drop = false
            bool touched = high >= a.bot and low <= a.top
            if a.status == "formed" and touched
                a.status := "tapped"
                a.tapBar := bar_index
            else if touched and a.status == "tapped" and not a.alertedTap
                a.tapBar := bar_index
            if touched
                a.lastBar := bar_index
            if a.status != "mitigated" and a.mitRule != MIT_NONE
                bool mit = false
                if a.mitRule == MIT_SWEEP
                    mit := a.dir >= 0 ? high > a.top : low < a.bot
                    if mit
                        evt.set(0, a.tag + " @ " + str.tostring(a.dir >= 0 ? a.top : a.bot, format.mintick) + " (bar " + str.tostring(bar_index) + ")")
                else if a.mitRule == MIT_CE
                    mit := low <= a.ce and high >= a.ce
                else if a.mitRule == MIT_FRAC
                    lvl = a.dir >= 0 ? a.top - a.mitFrac * (a.top - a.bot) : a.bot + a.mitFrac * (a.top - a.bot)
                    mit := a.dir >= 0 ? low <= lvl : high >= lvl
                else
                    mit := a.dir >= 0 ? close < a.bot : close > a.top
                if mit
                    a.status := "mitigated"
                    a.mitBar := bar_index
            if a.status == "mitigated"
                if a.mitHandling == MH_REMOVE
                    drop := true
                else if a.mitHandling == MH_FADE and (bar_index - a.mitBar) > gPivR + 20
                    drop := true
            if not drop and a.status != "mitigated" and (bar_index - a.lastBar) > a.maxAge
                drop := true
            dist = math.min(math.abs(close - a.top), math.abs(close - a.bot))
            if a.alertedTap and dist > alResetAtr * atr
                a.alertedTap := false
            if drop
                f_delete(a)
                reg.remove(i)

// Decluttering: per module keep only the strongest/most-recent `Max Shown`.
// Field writes go through a local var (Pine can't assign to array.get(i).field).
f_declutter() =>
    if reg.size() > 0
        for m = 1 to 18
            keep = f_modMax(m)
            cnt  = 0
            for i = 0 to reg.size() - 1
                ei = reg.get(i)
                if ei.mod == m
                    cnt += 1
                    ei.shown := true
            if cnt > keep
                for i = 0 to reg.size() - 1
                    ej = reg.get(i)
                    if ej.mod == m
                        ej.shown := false
                for pass = 0 to keep - 1
                    bi = -1
                    bv = -1e30
                    for i = 0 to reg.size() - 1
                        e = reg.get(i)
                        if e.mod == m and not e.shown
                            sc = e.strength * 1e6 - (bar_index - e.lastBar) * 1.0
                            if sc > bv
                                bv := sc
                                bi := i
                    if bi >= 0
                        eb = reg.get(bi)
                        eb.shown := true

// Rendering: (re)draw each array's handles honoring compact mode + status.
// Every "create if missing" is a lone `if` followed by unconditional set_*()
// calls — so no if/else returns two different types (Pine CE10235) and the
// loop body always ends on a void statement.
f_render() =>
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            a = reg.get(i)
            if not (a.shown and f_modOn(a.mod) and inLB and (bar_index - a.bornBar) <= gLookback)
                f_delete(a)
                continue
            c      = f_color(a)
            agef   = math.min(1.0, (bar_index - a.lastBar) / 300.0)
            tr     = int(math.min(95.0, gTranspBase + agef * 12.0 + (a.status == "mitigated" ? 10.0 : 0.0)))
            trB    = math.max(0, tr - 40)
            trCe   = math.max(0, tr - 30)
            rightX = a.extend ? bar_index + 10 : bar_index + 2
            dstyle = a.status == "mitigated" ? line.style_dotted : line.style_solid
            if a.isLevel
                if na(a.ln1)
                    a.ln1 := line.new(a.bornBar, a.top, rightX, a.top, xloc = xloc.bar_index, width = 1)
                line.set_xy1(a.ln1, a.bornBar, a.top)
                line.set_xy2(a.ln1, rightX, a.top)
                line.set_color(a.ln1, color.new(c, trB))
                line.set_style(a.ln1, dstyle)
                if a.twoLine and na(a.ln2)
                    a.ln2 := line.new(a.bornBar, a.bot, rightX, a.bot, xloc = xloc.bar_index, width = 1)
                if a.twoLine and not na(a.ln2)
                    line.set_xy1(a.ln2, a.bornBar, a.bot)
                    line.set_xy2(a.ln2, rightX, a.bot)
                    line.set_color(a.ln2, color.new(c, trB))
                    line.set_style(a.ln2, dstyle)
            else
                if na(a.bx)
                    a.bx := box.new(a.bornBar, a.top, rightX, a.bot, xloc = xloc.bar_index)
                box.set_lefttop(a.bx, a.bornBar, a.top)
                box.set_rightbottom(a.bx, rightX, a.bot)
                box.set_bgcolor(a.bx, color.new(c, tr))
                box.set_border_color(a.bx, color.new(c, trB))
                box.set_border_style(a.bx, dstyle)
                box.set_border_width(a.bx, 1)
                if a.showCe and not gCompact and na(a.lnCe)
                    a.lnCe := line.new(a.bornBar, a.ce, rightX, a.ce, xloc = xloc.bar_index, style = line.style_dashed, width = 1)
                if a.showCe and not gCompact and not na(a.lnCe)
                    line.set_xy1(a.lnCe, a.bornBar, a.ce)
                    line.set_xy2(a.lnCe, rightX, a.ce)
                    line.set_color(a.lnCe, color.new(c, trCe))
                if (not a.showCe or gCompact) and not na(a.lnCe)
                    line.delete(a.lnCe)
                    a.lnCe := na
            bool wantLabel = not (gCompact and a.strength < 1.2)
            if (not wantLabel) and not na(a.lb)
                label.delete(a.lb)
                a.lb := na
            if wantLabel
                // levels: small bubble at the right edge.  zonal arrays: plain
                // text pinned to the origin (bornBar) so labels spread along
                // time instead of stacking on the current bar.
                lx     = a.isLevel ? rightX : a.bornBar
                ly     = a.top
                lstyle = a.isLevel ? label.style_label_left : label.style_none
                txt    = a.tag + ((a.mod == M_EQ or a.mod == M_LIQ) and a.count > 1 ? " x" + str.tostring(a.count) : "")
                if na(a.lb)
                    a.lb := label.new(lx, ly, txt, xloc = xloc.bar_index, size = size.tiny)
                label.set_xy(a.lb, lx, ly)
                label.set_text(a.lb, txt)
                label.set_style(a.lb, lstyle)
                label.set_color(a.lb, a.isLevel ? color.new(c, 20) : color.new(color.white, 100))
                label.set_textcolor(a.lb, a.isLevel ? color.new(color.white, 0) : color.new(c, 0))

// ═════════════════════════════ MODULE DETECTORS ═════════════════════════════
// Each runs once per confirmed bar (from MAIN) when its module is enabled.

// ─── ⑤ Fair Value Gap + CE  (E2 · S2.1) ───────────────────────────────
// BISI: low[0] > high[2].  SIBI: high[0] < low[2].  Zone = the 3-candle gap.
f_detect_fvg() =>
    float frac = fvgFill == "CE (50%)" ? 0.5 : 1.0
    int   mh   = f_mhCode(fvgMH)
    // bullish (BISI)
    if low > high[2]
        gap = low - high[2]
        if gap >= fvgMinAtr * atr and (not fvgReqDisp or bullDisp)
            f_register(PDArray.new(mod = M_FVG, tag = "FVG+", dir = 1, top = low, bot = high[2],
                 bornOff = 2, mitRule = MIT_FRAC, mitFrac = frac, mitHandling = mh, maxAge = fvgAge,
                 showCe = fvgShowCe))
    // bearish (SIBI)
    if high < low[2]
        gap = low[2] - high
        if gap >= fvgMinAtr * atr and (not fvgReqDisp or bearDisp)
            f_register(PDArray.new(mod = M_FVG, tag = "FVG-", dir = -1, top = low[2], bot = high,
                 bornOff = 2, mitRule = MIT_FRAC, mitFrac = frac, mitHandling = mh, maxAge = fvgAge,
                 showCe = fvgShowCe))

// ─── ⑥ Inversion FVG  (E2 · S2.2) ─────────────────────────────────────
// An existing FVG that price closes fully through flips polarity → IFVG.
f_detect_ifvg() =>
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == M_FVG and e.flag == 0
                bool through = e.dir >= 0 ? close < e.bot : close > e.top
                if through
                    e.flag   := 1
                    e.status := "mitigated"
                    e.mitBar := bar_index
                    ndir = e.dir >= 0 ? -1 : 1
                    f_register(PDArray.new(mod = M_IFVG, tag = ndir > 0 ? "IFVG+" : "IFVG-", dir = ndir,
                         top = e.top, bot = e.bot, bornOff = bar_index - e.bornBar, mitRule = MIT_FRAC,
                         mitFrac = 1.0, mitHandling = f_mhCode(ifvgMH), maxAge = ifvgAge))

// ─── ⑦ Liquidity Void  (E2 · S2.3) ───────────────────────────────────
// Fast one-directional run: N same-colour bars, big directional range, strong bodies.
f_detect_lv() =>
    int n = lvMinBars
    bool up = true
    bool dn = true
    for k = 0 to n - 1
        r  = high[k] - low[k]
        br = r > 0 ? math.abs(close[k] - open[k]) / r : 0.0
        if br < 0.5
            up := false
            dn := false
        if close[k] <= open[k]
            up := false
        if close[k] >= open[k]
            dn := false
    if up
        rng = high - low[n - 1]
        if rng >= lvMinAtr * atr and close > close[n - 1]
            f_register(PDArray.new(mod = M_LV, tag = "LV+", dir = 1, top = high, bot = low[n - 1],
                 bornOff = n - 1, mitRule = MIT_FRAC, mitFrac = lvFillPct / 100.0,
                 mitHandling = f_mhCode(lvMH), maxAge = lvAge))
    if dn
        rng = high[n - 1] - low
        if rng >= lvMinAtr * atr and close < close[n - 1]
            f_register(PDArray.new(mod = M_LV, tag = "LV-", dir = -1, top = high[n - 1], bot = low,
                 bornOff = n - 1, mitRule = MIT_FRAC, mitFrac = lvFillPct / 100.0,
                 mitHandling = f_mhCode(lvMH), maxAge = lvAge))

// ─── ⑧ Volume Imbalance  (E2 · S2.4) ─────────────────────────────────
// Body gap between consecutive candles while their wicks still overlap.
f_detect_vi() =>
    int mh = f_mhCode(viMH)
    if open > close[1] and low <= high[1] and (open - close[1]) >= 0.05 * atr
        f_register(PDArray.new(mod = M_VI, tag = "VI+", dir = 1, top = open, bot = close[1],
             bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0, mitHandling = mh, maxAge = viAge))
    if open < close[1] and high >= low[1] and (close[1] - open) >= 0.05 * atr
        f_register(PDArray.new(mod = M_VI, tag = "VI-", dir = -1, top = close[1], bot = open,
             bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0, mitHandling = mh, maxAge = viAge))

// ─── ⑨ Opening Gaps — NDOG / NWOG  (E2 · S2.5) ───────────────────────
f_detect_og() =>
    if not timeframe.isdwm
        int mh = f_mhCode(ogMH)
        bool newDay  = newDayG
        bool newWeek = newWeekG
        if ogNwog and newWeek and not na(close[1]) and math.abs(open - close[1]) >= 0.05 * atr
            d = open > close[1] ? 1 : -1
            f_register(PDArray.new(mod = M_OG, tag = "NWOG", dir = d, top = math.max(open, close[1]),
                 bot = math.min(open, close[1]), bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0,
                 mitHandling = mh, maxAge = ogAge, showCe = true))
        else if ogNdog and newDay and not na(close[1]) and math.abs(open - close[1]) >= 0.05 * atr
            d = open > close[1] ? 1 : -1
            f_register(PDArray.new(mod = M_OG, tag = "NDOG", dir = d, top = math.max(open, close[1]),
                 bot = math.min(open, close[1]), bornOff = 1, mitRule = MIT_FRAC, mitFrac = 1.0,
                 mitHandling = mh, maxAge = ogAge, showCe = true))

// ─── ⑭ Balanced Price Range  (E2 · S2.6) ─────────────────────────────
// Overlap of a bullish and a bearish FVG formed within N bars of each other.
f_detect_bpr() =>
    if reg.size() > 1
        for i = 0 to reg.size() - 1
            eb = reg.get(i)
            if eb.mod == M_FVG and eb.dir >= 0
                for j = 0 to reg.size() - 1
                    es = reg.get(j)
                    if es.mod == M_FVG and es.dir < 0
                        newPair = eb.regBar == bar_index or es.regBar == bar_index
                        near    = math.abs(eb.bornBar - es.bornBar) <= bprMaxApart
                        ot      = math.min(eb.top, es.top)
                        ob      = math.max(eb.bot, es.bot)
                        if newPair and near and ot > ob
                            f_register(PDArray.new(mod = M_BPR, tag = "BPR", dir = 0, top = ot, bot = ob,
                                 bornOff = bar_index - math.min(eb.bornBar, es.bornBar), mitRule = MIT_FRAC,
                                 mitFrac = 1.0, mitHandling = f_mhCode(bprMH), maxAge = bprAge))

// ─── helper: does an un-mitigated array of module m + dir d overlap [t,b]? ───
f_hasOverlap(int m, int d, float t, float b) =>
    bool found = false
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == m and e.dir == d and e.status != "mitigated" and f_overlap(t, b, e.top, e.bot) > 0
                found := true
                break
    found

// ─── helper: register a single horizontal level array ───
f_level(int m, string tg, int d, float px, bool ext, int mh, int maxAge, color cc) =>
    if not na(px)
        f_register(PDArray.new(mod = m, tag = tg, dir = d, top = px, bot = px, isLevel = true,
             extend = ext, bornOff = 1, mitRule = MIT_SWEEP, mitHandling = mh, maxAge = maxAge, col = cc))

// ─── ① Order Block (+ propulsion)  (E3 · S3.1) ───────────────────────
// Last opposite-close candle before a displacement leg. Structure-break
// requirement is approximated by the displacement gate (module ⑯); the
// OB<->breaker distinction is refined by module ⑱ (see PRD §8).
f_detect_ob() =>
    int   mh   = f_mhCode(obMH)
    int   look = 6
    // bullish OB — rising edge of an up displacement
    if (not obReqDisp or bullDisp) and (obReqDisp ? not bullDisp[1] : close > open and close[1] < open[1])
        int kk = -1
        for k = 1 to look
            if kk < 0 and close[k] < open[k]
                kk := k
        if kk >= 0
            t = obBodyOnly ? math.max(open[kk], close[kk]) : high[kk]
            b = obBodyOnly ? math.min(open[kk], close[kk]) : low[kk]
            prop = f_hasOverlap(M_OB, 1, t, b)
            f_register(PDArray.new(mod = M_OB, tag = prop ? "OB+^" : "OB+", dir = 1, top = t, bot = b,
                 bornOff = kk, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = obAge, showCe = true))
    // bearish OB
    if (not obReqDisp or bearDisp) and (obReqDisp ? not bearDisp[1] : close < open and close[1] > open[1])
        int kk = -1
        for k = 1 to look
            if kk < 0 and close[k] > open[k]
                kk := k
        if kk >= 0
            t = obBodyOnly ? math.max(open[kk], close[kk]) : high[kk]
            b = obBodyOnly ? math.min(open[kk], close[kk]) : low[kk]
            prop = f_hasOverlap(M_OB, -1, t, b)
            f_register(PDArray.new(mod = M_OB, tag = prop ? "OB-^" : "OB-", dir = -1, top = t, bot = b,
                 bornOff = kk, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = obAge, showCe = true))

// ─── ② Breaker Block  (E3 · S3.2) ────────────────────────────────────
// An OB that is violated (close beyond it) and then retested from the far
// side flips role: broken bull OB -> bearish breaker, and vice versa.
f_detect_brk() =>
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.mod == M_OB and e.flag == 0
                violated = e.dir >= 0 ? close < e.bot : close > e.top
                if violated
                    e.flag := 1
            if e.mod == M_OB and e.flag == 1
                retest = high >= e.bot and low <= e.top
                if retest
                    e.flag := 2
                    ndir = e.dir >= 0 ? -1 : 1
                    f_register(PDArray.new(mod = M_BRK, tag = ndir > 0 ? "BRK+" : "BRK-", dir = ndir,
                         top = e.top, bot = e.bot, bornOff = bar_index - e.bornBar,
                         mitRule = MIT_FAREDGE, mitHandling = f_mhCode(brkMH), maxAge = brkAge, showCe = true))

// ─── ③ Mitigation Block  (E3 · S3.3) ─────────────────────────────────
// The "weak" OB counterpart: an opposite-close candle preceding a NON-
// displacement reversal (no structure break). Distinct from a breaker,
// which requires the prior block to be violated first (PRD §8).
f_detect_mb() =>
    int mh = f_mhCode(mbMH)
    if close > open and close[1] < open[1] and not bullDisp and (close - open) >= 0.4 * (high - low)
        t = high[1]
        b = low[1]
        if not f_hasOverlap(M_OB, 1, t, b) and not f_hasOverlap(M_MB, 1, t, b)
            f_register(PDArray.new(mod = M_MB, tag = "MB+", dir = 1, top = t, bot = b, bornOff = 1,
                 mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = mbAge, showCe = true))
    if close < open and close[1] > open[1] and not bearDisp and (open - close) >= 0.4 * (high - low)
        t = high[1]
        b = low[1]
        if not f_hasOverlap(M_OB, -1, t, b) and not f_hasOverlap(M_MB, -1, t, b)
            f_register(PDArray.new(mod = M_MB, tag = "MB-", dir = -1, top = t, bot = b, bornOff = 1,
                 mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = mbAge, showCe = true))

// ─── ④ Rejection Block  (E3 · S3.4) ──────────────────────────────────
// Long-wick candle at a local extreme; zone = the wick.
f_detect_rb() =>
    int   mh  = f_mhCode(rbMH)
    rng  = high - low
    uw   = high - math.max(open, close)
    lw   = math.min(open, close) - low
    if rng > 0 and uw >= rbWickRatio * rng and uw >= rbMinWickAtr * atr and high >= high[1] and high >= high[2]
        f_register(PDArray.new(mod = M_RB, tag = "RB-", dir = -1, top = high, bot = math.max(open, close),
             bornOff = 0, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = rbAge))
    if rng > 0 and lw >= rbWickRatio * rng and lw >= rbMinWickAtr * atr and low <= low[1] and low <= low[2]
        f_register(PDArray.new(mod = M_RB, tag = "RB+", dir = 1, top = math.min(open, close), bot = low,
             bornOff = 0, mitRule = MIT_FAREDGE, mitHandling = mh, maxAge = rbAge))
// ─── ⑩ Buyside / Sellside Liquidity  (E4 · S4.1) ─────────────────────
// Every confirmed swing high is buyside liquidity (old high); every swing
// low is sellside. Rendered as an extended level; swept when price trades
// through it. Trendline liquidity (S4.2) is deferred — see PRD §8.
f_detect_liq() =>
    int mh = f_mhCode(liqMH)
    if liqBSL and not na(ph)
        f_register(PDArray.new(mod = M_LIQ, tag = "BSL", dir = 1, top = ph, bot = ph, isLevel = true,
             extend = true, bornOff = gPivR, mitRule = MIT_SWEEP, mitHandling = mh, maxAge = liqAge))
    if liqSSL and not na(pl)
        f_register(PDArray.new(mod = M_LIQ, tag = "SSL", dir = -1, top = pl, bot = pl, isLevel = true,
             extend = true, bornOff = gPivR, mitRule = MIT_SWEEP, mitHandling = mh, maxAge = liqAge))

// ─── ⑪ Equal Highs / Lows  (E4 · S4.3) ──────────────────────────────
// A new swing that lands within tolerance of a recent same-side swing marks
// a liquidity pool (EQH / EQL). Swept when price trades through the level.
f_detect_eq() =>
    tol = eqTolAtr * atr
    if not na(ph) and phBuf.size() > 0
        float matchP = na
        cnt = 1
        for i = 0 to phBuf.size() - 1
            if math.abs(phBuf.get(i) - ph) <= tol
                matchP := na(matchP) ? phBuf.get(i) : matchP
                cnt += 1
        if not na(matchP)
            lvl = (matchP + ph) / 2.0
            ah = PDArray.new(mod = M_EQ, tag = "EQH", dir = 1, top = lvl, bot = lvl, isLevel = true,
                 extend = true, bornOff = gPivR + 20, mitRule = MIT_SWEEP, mitHandling = f_mhCode(eqMH), maxAge = eqAge)
            ah.count := cnt
            f_register(ah)
    if not na(pl) and plBuf.size() > 0
        float matchP = na
        cnt = 1
        for i = 0 to plBuf.size() - 1
            if math.abs(plBuf.get(i) - pl) <= tol
                matchP := na(matchP) ? plBuf.get(i) : matchP
                cnt += 1
        if not na(matchP)
            lvl = (matchP + pl) / 2.0
            al = PDArray.new(mod = M_EQ, tag = "EQL", dir = -1, top = lvl, bot = lvl, isLevel = true,
                 extend = true, bornOff = gPivR + 20, mitRule = MIT_SWEEP, mitHandling = f_mhCode(eqMH), maxAge = eqAge)
            al.count := cnt
            f_register(al)

// ─── ⑯ Displacement leg drawing  (E4 · S4.4) ────────────────────────
// bullDisp / bearDisp are computed globally; this only draws the leg.
f_detect_disp() =>
    if bullDisp and not bullDisp[1]
        f_register(PDArray.new(mod = M_DISP, tag = "DISP+", dir = 1, top = high, bot = low[dispMaxBars - 1],
             bornOff = dispMaxBars - 1, mitRule = MIT_FRAC, mitFrac = 1.0, mitHandling = MH_REMOVE, maxAge = 80))
    if bearDisp and not bearDisp[1]
        f_register(PDArray.new(mod = M_DISP, tag = "DISP-", dir = -1, top = high[dispMaxBars - 1], bot = low,
             bornOff = dispMaxBars - 1, mitRule = MIT_FRAC, mitFrac = 1.0, mitHandling = MH_REMOVE, maxAge = 80))

// ─── ⑱ Market Structure — BOS / MSS / CHoCH  (E4 · S4.5) ────────────
f_detect_ms() =>
    // refresh protected swings from the newest confirmed pivots
    if not na(ph)
        msState.set(0, ph)
        msState.set(1, bar_index - gPivR)
    if not na(pl)
        msState.set(2, pl)
        msState.set(3, bar_index - gPivR)
    pHigh = msState.get(0)
    pLow  = msState.get(2)
    trend = na(msState.get(4)) ? 0 : int(msState.get(4))
    upBasis = msBasis == "Close" ? close : high
    dnBasis = msBasis == "Close" ? close : low
    if not na(pHigh) and upBasis > pHigh
        isMssU = trend < 0
        if not isMssU or not msReqDisp or bullDisp
            tagU = isMssU ? "MSS ×" : "BOS ×"
            au = PDArray.new(mod = M_MS, tag = tagU, dir = 1, top = pHigh, bot = pHigh, isLevel = true,
                 bornOff = bar_index - int(msState.get(1)), mitRule = MIT_NONE, mitHandling = MH_KEEP,
                 maxAge = 4000, col = isMssU ? msMssCol : msBosCol)
            f_register(au)
            evt.set(1, (isMssU ? "MSS bull @ " : "BOS bull @ ") + str.tostring(pHigh, format.mintick))
            msState.set(0, na)
            msState.set(4, 1)
    if not na(pLow) and dnBasis < pLow
        isMssD = trend > 0
        if not isMssD or not msReqDisp or bearDisp
            tagD = isMssD ? "MSS ×" : "BOS ×"
            ad = PDArray.new(mod = M_MS, tag = tagD, dir = -1, top = pLow, bot = pLow, isLevel = true,
                 bornOff = bar_index - int(msState.get(3)), mitRule = MIT_NONE, mitHandling = MH_KEEP,
                 maxAge = 4000, col = isMssD ? msMssCol : msBosCol)
            f_register(ad)
            evt.set(1, (isMssD ? "MSS bear @ " : "BOS bear @ ") + str.tostring(pLow, format.mintick))
            msState.set(2, na)
            msState.set(4, -1)

// ─── ⑫ Dealing Range  (E5 · S5.1 / S5.2) ────────────────────────────
// Only computes the range into drBox[]; the premium/discount/EQ/OTE/fib
// drawing happens in a dedicated global block (fixed handle set, no clutter).
f_detect_dr() =>
    float t = na
    float b = na
    if drSrc == "Previous period"
        t := drPeriod == "Week" ? pwh : drPeriod == "Month" ? pmh : pdh
        b := drPeriod == "Week" ? pwl : drPeriod == "Month" ? pml : pdl
    else if drSrc == "Session"
        t := drSession == "Asia" ? sesAHc : drSession == "New York" ? sesNHc : sesLHc
        b := drSession == "Asia" ? sesALc : drSession == "New York" ? sesNLc : sesLLc
    else
        if phBuf.size() > 0 and plBuf.size() > 0
            t := phBuf.get(phBuf.size() - 1)
            b := plBuf.get(plBuf.size() - 1)
    if not na(t) and not na(b) and t > b
        drBox.set(0, t)
        drBox.set(1, b)
        // leg direction: +1 if the swing high is the more recent pivot
        d = 1
        if drSrc == "Auto swing" and phBarBuf.size() > 0 and plBarBuf.size() > 0
            d := phBarBuf.get(phBarBuf.size() - 1) >= plBarBuf.get(plBarBuf.size() - 1) ? 1 : -1
        drBox.set(2, d)

// ─── ⑬ Reference Levels — PDH/PDL, PWH/PWL, PMH/PML  (E5 · S5.3) ─────
f_detect_ref() =>
    int mh = f_mhCode(refMH)
    if refDay and newDayG
        f_level(M_REF, "PDH", 1, pdh, true, mh, 5000, refCol)
        f_level(M_REF, "PDL", -1, pdl, true, mh, 5000, refCol)
    if refWeek and newWeekG
        f_level(M_REF, "PWH", 1, pwh, true, mh, 5000, refCol)
        f_level(M_REF, "PWL", -1, pwl, true, mh, 5000, refCol)
    if refMonth and newMonthG
        f_level(M_REF, "PMH", 1, pmh, true, mh, 5000, refCol)
        f_level(M_REF, "PML", -1, pml, true, mh, 5000, refCol)

// ─── ⑰ Key Levels & Opens  (E5 · S5.4) ──────────────────────────────
f_detect_kl() =>
    if not timeframe.isdwm
        if klMidnight and _nyDayChg
            f_level(M_KL, "TDO", 0, open, true, MH_KEEP, 3000, klOpenCol)
        if klEight and _ny0830
            f_level(M_KL, "08:30", 0, open, true, MH_KEEP, 3000, klOpenCol)
        if klAsia and _inA[1] and not _inA and not na(sesAHc)
            f_level(M_KL, "ASIA H", 1, sesAHc, false, MH_KEEP, 3000, klSesCol)
            f_level(M_KL, "ASIA L", -1, sesALc, false, MH_KEEP, 3000, klSesCol)
        if klLondon and _inL[1] and not _inL and not na(sesLHc)
            f_level(M_KL, "LDN H", 1, sesLHc, false, MH_KEEP, 3000, klSesCol)
            f_level(M_KL, "LDN L", -1, sesLLc, false, MH_KEEP, 3000, klSesCol)
        if klNY and _inN[1] and not _inN and not na(sesNHc)
            f_level(M_KL, "NY H", 1, sesNHc, false, MH_KEEP, 3000, klSesCol)
            f_level(M_KL, "NY L", -1, sesNLc, false, MH_KEEP, 3000, klSesCol)
// ─── ⑮ SMT Divergence  (E6 · S6.1 / S6.2) ──────────────────────────
// At a fresh chart pivot, compare the chart's HH/LL against a correlated
// symbol's over the same two swing bars. Disagreement = SMT divergence.
var array<line> smtLn = array.new<line>()
f_smtTrim() =>
    while smtLn.size() > smtMax
        line.delete(smtLn.shift())

f_detect_smt() =>
    // ── bearish SMT at highs ──
    if not na(ph) and phBuf.size() >= 1
        prevPx  = phBuf.get(phBuf.size() - 1)
        prevBar = phBarBuf.get(phBarBuf.size() - 1)
        chartHH = ph > prevPx
        c1now = smtH1[gPivR]
        c1pre = smtPh1.get(smtPh1.size() - 1)
        c2now = smtH2[gPivR]
        c2pre = smtPh2.get(smtPh2.size() - 1)
        div1 = not na(c1now) and not na(c1pre) and (chartHH != (c1now > c1pre))
        div2 = smtSym2 != "" and not na(c2now) and not na(c2pre) and (chartHH != (c2now > c2pre))
        if div1 or div2
            f_register(PDArray.new(mod = M_SMT, tag = "SMT bear", dir = -1, top = ph, bot = ph,
                 isLevel = true, bornOff = gPivR, mitRule = MIT_NONE, mitHandling = MH_KEEP,
                 maxAge = 400, col = smtBearCol))
            evt.set(2, "bear @ " + str.tostring(ph, format.mintick))
            if smtLine
                smtLn.push(line.new(prevBar, prevPx, bar_index - gPivR, ph, color = smtBearCol, width = 1, style = line.style_dotted))
                f_smtTrim()
    // ── bullish SMT at lows ──
    if not na(pl) and plBuf.size() >= 1
        prevPx  = plBuf.get(plBuf.size() - 1)
        prevBar = plBarBuf.get(plBarBuf.size() - 1)
        chartLL = pl < prevPx
        c1now = smtL1[gPivR]
        c1pre = smtPl1.get(smtPl1.size() - 1)
        c2now = smtL2[gPivR]
        c2pre = smtPl2.get(smtPl2.size() - 1)
        div1 = not na(c1now) and not na(c1pre) and (chartLL != (c1now < c1pre))
        div2 = smtSym2 != "" and not na(c2now) and not na(c2pre) and (chartLL != (c2now < c2pre))
        if div1 or div2
            f_register(PDArray.new(mod = M_SMT, tag = "SMT bull", dir = 1, top = pl, bot = pl,
                 isLevel = true, bornOff = gPivR, mitRule = MIT_NONE, mitHandling = MH_KEEP,
                 maxAge = 400, col = smtBullCol))
            evt.set(2, "bull @ " + str.tostring(pl, format.mintick))
            if smtLine
                smtLn.push(line.new(prevBar, prevPx, bar_index - gPivR, pl, color = smtBullCol, width = 1, style = line.style_dotted))
                f_smtTrim()

// ═════════════════════════════ MAIN ═════════════════════════════
if barstate.isconfirmed and inLB
    if f_modOn(M_FVG)
        f_detect_fvg()
    if f_modOn(M_IFVG)
        f_detect_ifvg()
    if f_modOn(M_LV)
        f_detect_lv()
    if f_modOn(M_VI)
        f_detect_vi()
    if f_modOn(M_OG)
        f_detect_og()
    if f_modOn(M_OB)
        f_detect_ob()
    if f_modOn(M_BRK)
        f_detect_brk()
    if f_modOn(M_MB)
        f_detect_mb()
    if f_modOn(M_RB)
        f_detect_rb()
    if f_modOn(M_LIQ)
        f_detect_liq()
    if f_modOn(M_EQ)
        f_detect_eq()
    if f_modOn(M_MS)
        f_detect_ms()
    if f_modOn(M_DR)
        f_detect_dr()
    if f_modOn(M_REF)
        f_detect_ref()
    if f_modOn(M_KL)
        f_detect_kl()
    if f_modOn(M_SMT)
        f_detect_smt()
    if f_modOn(M_BPR)
        f_detect_bpr()
    if f_modOn(M_DISP)
        f_detect_disp()
    // shared pivot buffers (used by modules ⑪ ⑮) — maintained AFTER detection so
    // this bar's own pivot isn't matched against itself.
    if not na(ph)
        phBuf.push(ph)
        phBarBuf.push(bar_index - gPivR)
        smtPh1.push(smtH1[gPivR])
        smtPh2.push(smtH2[gPivR])
        if phBuf.size() > PIV_BUF
            phBuf.shift()
            phBarBuf.shift()
            smtPh1.shift()
            smtPh2.shift()
    if not na(pl)
        plBuf.push(pl)
        plBarBuf.push(bar_index - gPivR)
        smtPl1.push(smtL1[gPivR])
        smtPl2.push(smtL2[gPivR])
        if plBuf.size() > PIV_BUF
            plBuf.shift()
            plBarBuf.shift()
            smtPl1.shift()
            smtPl2.shift()
    f_lifecycle()
    f_declutter()

// ═════════════════════════════ ALERT EVAL (E7 · S7.2) ═════════════════════════════
// Conditions are computed in global scope (functions may not call alert()).
bool alFormed = false
bool alTapped = false
bool alMitig  = false
bool alSwept  = false
bool alStruct = false
bool alSmt    = false
bool alOte    = false
if barstate.isconfirmed and reg.size() > 0
    for i = 0 to reg.size() - 1
        a = reg.get(i)
        bool isLevelMod = a.mod == M_LIQ or a.mod == M_REF or a.mod == M_EQ or a.mod == M_KL
        if a.regBar == bar_index
            alFormed := true
            if a.mod == M_MS
                alStruct := true
            if a.mod == M_SMT
                alSmt := true
            if alJson
                alert(f_payload("formed", a), alert.freq_once_per_bar_close)
        if a.tapBar == bar_index and not a.alertedTap
            a.alertedTap := true
            alTapped := true
            if alJson
                alert(f_payload("tapped", a), alert.freq_once_per_bar_close)
        if a.status == "mitigated" and a.mitBar == bar_index
            alMitig := true
            if isLevelMod
                alSwept := true
            if alJson
                alert(f_payload(isLevelMod ? "swept" : "mitigated", a), alert.freq_once_per_bar_close)
// price entered discount + OTE (module ⑫)
_drT = drBox.get(0)
_drB = drBox.get(1)
if barstate.isconfirmed and not na(_drT) and not na(_drB) and _drT > _drB
    _eq  = (_drT + _drB) / 2.0
    _d   = na(drBox.get(2)) ? 1 : int(drBox.get(2))
    _oA  = _d >= 0 ? _drT - drOteHi * (_drT - _drB) : _drB + drOteHi * (_drT - _drB)
    _oB  = _d >= 0 ? _drT - drOteLo * (_drT - _drB) : _drB + drOteLo * (_drT - _drB)
    _lo  = math.min(_oA, _oB)
    _hi  = math.max(_oA, _oB)
    alOte := low <= _hi and high >= _lo and (_d >= 0 ? close < _eq : close > _eq)

f_render()

// ═══════════════ ⑫ DEALING RANGE RENDER (fixed handle set, last bar) ═══════════════
// Kept out of the registry: a single structure, drawn on the last bar with
// reused handles so it never contributes to clutter or the object budget.
var box  drPremBx = na
var box  drDiscBx = na
var box  drOteBx  = na
var line drEqLn   = na
var array<line>  drFibLn  = array.new<line>()
var array<label> drFibLbl = array.new<label>()

if barstate.islast
    drT = drBox.get(0)
    drB = drBox.get(1)
    drD = na(drBox.get(2)) ? 1 : int(drBox.get(2))
    bool drAny = f_modOn(M_DR) and not na(drT) and not na(drB) and drT > drB
    // wipe fib handles every refresh (small count)
    if drFibLn.size() > 0
        for i = 0 to drFibLn.size() - 1
            line.delete(drFibLn.get(i))
        drFibLn.clear()
    if drFibLbl.size() > 0
        for i = 0 to drFibLbl.size() - 1
            label.delete(drFibLbl.get(i))
        drFibLbl.clear()
    if not drAny
        if not na(drPremBx)
            box.delete(drPremBx)
            drPremBx := na
        if not na(drDiscBx)
            box.delete(drDiscBx)
            drDiscBx := na
        if not na(drOteBx)
            box.delete(drOteBx)
            drOteBx := na
        if not na(drEqLn)
            line.delete(drEqLn)
            drEqLn := na
    else
        rngv = drT - drB
        eqv  = (drT + drB) / 2.0
        lft  = bar_index - 1
        rgt  = bar_index + 15
        if drShowBox
            if na(drPremBx)
                drPremBx := box.new(lft, drT, rgt, eqv, bgcolor = drPremCol, border_color = color.new(drEqCol, 70), border_width = 1)
                drDiscBx := box.new(lft, eqv, rgt, drB, bgcolor = drDiscCol, border_color = color.new(drEqCol, 70), border_width = 1)
            else
                box.set_lefttop(drPremBx, lft, drT)
                box.set_rightbottom(drPremBx, rgt, eqv)
                box.set_lefttop(drDiscBx, lft, eqv)
                box.set_rightbottom(drDiscBx, rgt, drB)
        else if not na(drPremBx)
            box.delete(drPremBx)
            drPremBx := na
            box.delete(drDiscBx)
            drDiscBx := na
        if na(drEqLn)
            drEqLn := line.new(lft, eqv, rgt, eqv, color = drEqCol, style = line.style_dashed, width = 1)
        else
            line.set_xy1(drEqLn, lft, eqv)
            line.set_xy2(drEqLn, rgt, eqv)
        oteA = drD >= 0 ? drT - drOteHi * rngv : drB + drOteHi * rngv
        oteB = drD >= 0 ? drT - drOteLo * rngv : drB + drOteLo * rngv
        if drShowOte
            oteTop = math.max(oteA, oteB)
            oteBot = math.min(oteA, oteB)
            if na(drOteBx)
                drOteBx := box.new(lft, oteTop, rgt, oteBot, bgcolor = color.new(drD >= 0 ? color.teal : color.red, 82), border_color = color.new(drEqCol, 50), border_width = 1)
            else
                box.set_lefttop(drOteBx, lft, oteTop)
                box.set_rightbottom(drOteBx, rgt, oteBot)
        else if not na(drOteBx)
            box.delete(drOteBx)
            drOteBx := na
        parts = str.split(drFibs, ",")
        if parts.size() > 0
            for i = 0 to parts.size() - 1
                fv = str.tonumber(str.trim(parts.get(i)))
                if not na(fv)
                    px = drD >= 0 ? drT - fv * rngv : drB + fv * rngv
                    drFibLn.push(line.new(lft, px, rgt, px, color = color.new(drEqCol, 30), style = line.style_dotted, width = 1))
                    drFibLbl.push(label.new(rgt, px, str.tostring(fv), style = label.style_none, textcolor = drEqCol, size = size.tiny))

// ═════════════════════════════ INFO PANEL ═════════════════════════════
var table ip = na
if ipShow and barstate.islast
    pos = switch ipPos
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right
    if na(ip)
        ip := table.new(pos, 2, 9, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
    else
        table.set_position(ip, pos)
    int modsOn = 0
    for m = 1 to 18
        modsOn += f_modOn(m) ? 1 : 0
    float  nBull  = na
    string nBullT = "—"
    float  nBear  = na
    string nBearT = "—"
    if reg.size() > 0
        for i = 0 to reg.size() - 1
            e = reg.get(i)
            if e.status != "mitigated" and e.shown
                if e.top <= close and (na(nBull) or e.top > nBull)
                    nBull  := e.top
                    nBullT := e.tag
                if e.bot >= close and (na(nBear) or e.bot < nBear)
                    nBear  := e.bot
                    nBearT := e.tag
    string drPosTxt = "—"
    drT = drBox.get(0)
    drB = drBox.get(1)
    if not na(drT) and not na(drB) and drT > drB
        pct = (close - drB) / (drT - drB) * 100.0
        drPosTxt := (pct >= 50 ? "Premium " : "Discount ") + str.tostring(pct, "#.#") + "%"
    table.cell(ip, 0, 0, "PD ARRAY SUITE", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 70))
    table.cell(ip, 1, 0, str.tostring(reg.size()) + " tracked", text_color = color.silver, text_size = size.small)
    table.cell(ip, 0, 1, "Dealing range", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 1, drPosTxt, text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 2, "Nearest ▲ below", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 2, nBullT + (na(nBull) ? "" : " " + str.tostring(nBull, format.mintick)), text_color = color.new(#26a69a, 0), text_size = size.small)
    table.cell(ip, 0, 3, "Nearest ▼ above", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 3, nBearT + (na(nBear) ? "" : " " + str.tostring(nBear, format.mintick)), text_color = color.new(#ef5350, 0), text_size = size.small)
    table.cell(ip, 0, 4, "Last sweep", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 4, evt.get(0), text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 5, "Last structure", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 5, evt.get(1), text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 6, "Last SMT", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 6, evt.get(2), text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 7, "Displacement", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 7, bullDisp ? "▲ bull" : bearDisp ? "▼ bear" : "—", text_color = color.white, text_size = size.small)
    table.cell(ip, 0, 8, "Modules / volume", text_color = color.silver, text_size = size.small)
    table.cell(ip, 1, 8, str.tostring(modsOn) + "/18 · vol " + (volOk ? "ok" : "n/a"), text_color = color.white, text_size = size.small)

// ═════════════════════════════ STATIC ALERTS (E7 · S7.2) ═════════════════════════════
alertcondition(alFormed, "PD Array — formed",       "A PD array formed")
alertcondition(alTapped, "PD Array — tapped",       "Price tapped a PD array")
alertcondition(alMitig,  "PD Array — mitigated",    "A PD array was mitigated")
alertcondition(alSwept,  "Liquidity swept",         "Buyside/Sellside liquidity / reference level was swept")
alertcondition(alStruct, "Market structure shift",  "BOS / MSS / CHoCH")
alertcondition(alSmt,    "SMT divergence",          "SMT divergence detected")
alertcondition(alOte,    "Discount + OTE entry",    "Price entered the discount OTE zone of the dealing range")
